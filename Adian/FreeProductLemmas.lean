/-!
# Free Product, Free Group, Affine Group, and HNN Subgroups Lemmas

This file collects the combinatorial group theory lemmas shared between the Novikov–Boone
construction (`Adian/NovikovBoone.lean`) and Rabin's embedding lemma (`Adian/Rabin.lean`):

1. `coprodEquivCoprodI`: Equivalence `G ∗ H ≃* CoprodI (TwoFam G H)` giving unique reduced
   normal forms (`CoprodI.Word`) for binary free products, and injectivity of `Coprod.map`.
2. `freeRetract` and `map_mem_closure_of_iff`: Retraction characterization of subgroups of free
   groups generated by subsets of the basis.
3. `ModBase` (`Multiplicative (ℤ × ℤ) ∗ Multiplicative ℤ`) and `kerProjBasis`: Free basis
   `{ g(p)⁻¹ * t * g(p) | p ∈ ℤ × ℤ }` of `ker(fst : ModBase →* Multiplicative (ℤ × ℤ))`.
4. `AffQ`: The 2×2 affine group over `ℚ`, giving elementary infinite-order and disjointness
   proofs for the Baumslag–Solitar group `BS(1, 2) = ⟨b, c | c⁻¹ b c = b²⟩`.
5. `commutator_zpow_eq_one`: If `w ≠ 1` in `K`, then `[w, z]` has infinite order in `K ∗ ℤ`.
6. `rabinP_injective`, `rabinQ_injective`, and disjointness from `Coprod.inl.range` in `M ∗ ℤ`.
7. `hnn_free_pair_injective`: In `HNNExtension G A B φ`, if `b : G` has infinite order and
   `⟨b⟩ ∩ A = ⊥` and `⟨b⟩ ∩ B = ⊥`, then `⟨of b, t⟩` is free of rank 2.
-/

@[expose] public section

open Monoid Subgroup

namespace Adian

/-! ### Part 1: Equivalence `Monoid.Coprod G H ≃* Monoid.CoprodI (TwoFam G H)` -/

section CoprodNormalForm

/-- Binary family `false ↦ G`, `true ↦ H` for indexing `Monoid.CoprodI`. -/
abbrev TwoFam (G H : Type u) : Bool → Type u
  | false => G
  | true => H

instance instGroupTwoFam (G H : Type u) [Group G] [Group H] : ∀ b : Bool, Group (TwoFam G H b)
  | false => inferInstanceAs (Group G)
  | true => inferInstanceAs (Group H)

instance instDecidableEqTwoFam (G H : Type u) [DecidableEq G] [DecidableEq H] :
    ∀ b : Bool, DecidableEq (TwoFam G H b)
  | false => inferInstanceAs (DecidableEq G)
  | true => inferInstanceAs (DecidableEq H)

/-- Equivalence between `G ∗ H` and the indexed coproduct `CoprodI (TwoFam G H)`. -/
def coprodEquivCoprodI (G H : Type u) [Group G] [Group H] :
    Coprod G H ≃* CoprodI (TwoFam G H) :=
  MonoidHom.toMulEquiv
    (Coprod.lift (CoprodI.of (M := TwoFam G H) (i := false))
      (CoprodI.of (M := TwoFam G H) (i := true)))
    (CoprodI.lift fun b => match b with
      | false => Coprod.inl
      | true => Coprod.inr)
    (by
      apply Coprod.hom_ext
      · ext g; simp
      · ext h; simp)
    (by
      apply CoprodI.ext_hom
      intro b
      cases b <;> ext x <;> simp)

@[simp]
theorem coprodEquivCoprodI_inl {G H : Type u} [Group G] [Group H] (g : G) :
    coprodEquivCoprodI G H (Coprod.inl g) = CoprodI.of (M := TwoFam G H) (i := false) g := rfl

@[simp]
theorem coprodEquivCoprodI_inr {G H : Type u} [Group G] [Group H] (h : H) :
    coprodEquivCoprodI G H (Coprod.inr h) = CoprodI.of (M := TwoFam G H) (i := true) h := rfl

@[simp]
theorem coprodEquivCoprodI_symm_false {G H : Type u} [Group G] [Group H] (g : G) :
    (coprodEquivCoprodI G H).symm (CoprodI.of (M := TwoFam G H) (i := false) g) =
      Coprod.inl g := by
  simp [coprodEquivCoprodI]

@[simp]
theorem coprodEquivCoprodI_symm_true {G H : Type u} [Group G] [Group H] (h : H) :
    (coprodEquivCoprodI G H).symm (CoprodI.of (M := TwoFam G H) (i := true) h) =
      Coprod.inr h := by
  simp [coprodEquivCoprodI]

/-- Mapping injective homomorphisms onto a free product yields an injective homomorphism. -/
theorem coprod_map_injective {G₁ G₂ H₁ H₂ : Type u} [Group G₁] [Group G₂] [Group H₁] [Group H₂]
    (f : G₁ →* H₁) (g : G₂ →* H₂) (hf : Function.Injective f) (hg : Function.Injective g) :
    Function.Injective (Coprod.map f g) := by
  classical
  rw [injective_iff_map_eq_one]
  intro x hx
  let w : CoprodI.Word (TwoFam G₁ G₂) := CoprodI.Word.equiv (coprodEquivCoprodI G₁ G₂ x)
  have hw_prod : CoprodI.Word.prod w = coprodEquivCoprodI G₁ G₂ x :=
    CoprodI.Word.equiv.symm_apply_apply _
  let mapLetter : (Σ b, TwoFam G₁ G₂ b) → (Σ b, TwoFam H₁ H₂ b)
    | ⟨false, a⟩ => ⟨false, f a⟩
    | ⟨true, b⟩ => ⟨true, g b⟩
  let w' : CoprodI.Word (TwoFam H₁ H₂) :=
    { toList := w.toList.map mapLetter
      ne_one := by
        intro l hl
        rw [List.mem_map] at hl
        rcases hl with ⟨⟨b, a⟩, ha, rfl⟩
        have hne := w.ne_one ⟨b, a⟩ ha
        cases b
        · exact fun h => hne (hf (h.trans (map_one f).symm))
        · exact fun h => hne (hg (h.trans (map_one g).symm))
      chain_ne := by
        rw [List.isChain_map]
        refine w.chain_ne.imp ?_
        intro a b hab
        rcases a with ⟨ba, _⟩
        rcases b with ⟨bb, _⟩
        cases ba <;> cases bb <;> simp [mapLetter] at hab ⊢ }
  have hw'_prod : CoprodI.Word.prod w' = coprodEquivCoprodI H₁ H₂ (Coprod.map f g x) := by
    have hmap : ∀ l : List (Σ b, TwoFam G₁ G₂ b),
        (l.map fun s => CoprodI.of (mapLetter s).2).prod =
        coprodEquivCoprodI H₁ H₂ (Coprod.map f g
          ((coprodEquivCoprodI G₁ G₂).symm
            (l.map fun s => CoprodI.of s.2).prod)) := by
      intro l
      induction l with
      | nil => simp
      | cons s ls ih =>
        rcases s with ⟨b, a⟩
        cases b <;> simp [mapLetter, ih, coprodEquivCoprodI]
    have h1 := hmap w.toList
    change CoprodI.Word.prod w' = _
    simp only [CoprodI.Word.prod, w', List.map_map, Function.comp_def]
    rw [h1]
    change coprodEquivCoprodI H₁ H₂ (Coprod.map f g
      ((coprodEquivCoprodI G₁ G₂).symm (CoprodI.Word.prod w))) = _
    rw [hw_prod, MulEquiv.symm_apply_apply]
  rw [hx, map_one] at hw'_prod
  have hw'_empty : w' = CoprodI.Word.empty :=
    CoprodI.Word.equiv.symm.injective (by simpa [CoprodI.Word.equiv] using hw'_prod)
  have hnil : w.toList = [] := by
    have := congrArg (fun u => u.toList.length) hw'_empty
    simp [w'] at this
    exact this
  have hw_empty : w = CoprodI.Word.empty := CoprodI.Word.ext hnil
  rw [hw_empty, CoprodI.Word.prod_empty] at hw_prod
  exact (coprodEquivCoprodI G₁ G₂).injective (by simpa using hw_prod.symm)

end CoprodNormalForm

/-! ### Part 2: Free-Group Retraction Characterization of Subgroups Generated by Basis Subsets -/

section FreeRetract

/-- Retraction `FreeGroup α →* FreeGroup α` fixing generators in `S` and killing those outside `S`. -/
noncomputable def freeRetract {α : Type*} (S : Set α) : FreeGroup α →* FreeGroup α :=
  letI := Classical.decPred (· ∈ S)
  FreeGroup.lift fun a => if a ∈ S then FreeGroup.of a else 1

@[simp]
theorem freeRetract_of {α : Type*} (S : Set α) (a : α) [Decidable (a ∈ S)] :
    freeRetract S (FreeGroup.of a) = if a ∈ S then FreeGroup.of a else 1 := by
  classical
  simp [freeRetract]

theorem freeRetract_mem_closure {α : Type*} (S : Set α) (w : FreeGroup α) :
    freeRetract S w ∈ Subgroup.closure (FreeGroup.of '' S) := by
  induction w using FreeGroup.induction_on with
  | one => simp [one_mem]
  | of a =>
    classical
    rw [freeRetract_of]
    split_ifs with h
    · exact Subgroup.subset_closure ⟨a, h, rfl⟩
    · exact one_mem _
  | inv_of a _ =>
    rw [map_inv]
    apply inv_mem
    classical
    rw [freeRetract_of]
    split_ifs with h
    · exact Subgroup.subset_closure ⟨a, h, rfl⟩
    · exact one_mem _
  | mul x y hx hy =>
    rw [map_mul]
    exact mul_mem hx hy

theorem freeRetract_eq_self_of_mem {α : Type*} {S : Set α} {w : FreeGroup α}
    (hw : w ∈ Subgroup.closure (FreeGroup.of '' S)) : freeRetract S w = w := by
  refine Subgroup.closure_induction ?_ (map_one _) (fun _ _ _ _ hx hy => by rw [map_mul, hx, hy])
    (fun _ _ hx => by rw [map_inv, hx]) hw
  rintro _ ⟨a, ha, rfl⟩
  classical
  simp [ha]

theorem mem_closure_of_iff_freeRetract {α : Type*} (S : Set α) (w : FreeGroup α) :
    w ∈ Subgroup.closure (FreeGroup.of '' S) ↔ freeRetract S w = w :=
  ⟨freeRetract_eq_self_of_mem, fun h => h ▸ freeRetract_mem_closure S w⟩

theorem freeRetract_comp_map {α β : Type*} (S : Set α) (f : β → α) :
    (freeRetract S).comp (FreeGroup.map f) =
      (FreeGroup.map f).comp (freeRetract (f ⁻¹' S)) := by
  classical
  apply FreeGroup.ext_hom
  intro b
  simp only [MonoidHom.comp_apply, FreeGroup.map.of, freeRetract_of, Set.mem_preimage]
  split_ifs <;> simp

theorem map_mem_closure_of_iff {α β : Type*} {f : β → α} (hf : Function.Injective f)
    (S : Set α) (w : FreeGroup β) :
    FreeGroup.map f w ∈ Subgroup.closure (FreeGroup.of '' S) ↔
      w ∈ Subgroup.closure (FreeGroup.of '' (f ⁻¹' S)) := by
  rw [mem_closure_of_iff_freeRetract, mem_closure_of_iff_freeRetract]
  have hcomp := congrFun (congrArg DFunLike.coe (freeRetract_comp_map S f)) w
  simp only [MonoidHom.comp_apply] at hcomp
  rw [hcomp]
  exact (FreeGroup.map_injective hf).eq_iff

theorem of_mem_closure_of_iff {α : Type*} (S : Set α) (a : α) :
    FreeGroup.of a ∈ Subgroup.closure (FreeGroup.of '' S) ↔ a ∈ S := by
  classical
  rw [mem_closure_of_iff_freeRetract, freeRetract_of]
  by_cases ha : a ∈ S
  · simp [ha]
  · simp only [ha, ↓reduceIte, iff_false]
    exact Ne.symm (FreeGroup.of_ne_one a)

end FreeRetract

/-! ### Part 3: The Base Group `ModBase = (ℤ × ℤ) ∗ ℤ` for Novikov–Boone -/

section ModBase

/-- Base group `ℤ² ∗ ℤ` for the Aanderaa–Cohen modular machine group construction. -/
abbrev ModBase : Type := Coprod (Multiplicative (ℤ × ℤ)) (Multiplicative ℤ)

/-- Element `x^p.1 * y^p.2` in the `ℤ²` factor of `ModBase`. -/
def mbG (p : ℤ × ℤ) : ModBase :=
  Coprod.inl (Multiplicative.ofAdd p)

/-- Generator `x` of `ModBase`. -/
def mbX : ModBase := mbG (1, 0)

/-- Generator `y` of `ModBase`. -/
def mbY : ModBase := mbG (0, 1)

/-- Generator `t` of `ModBase`. -/
def mbT : ModBase := Coprod.inr (Multiplicative.ofAdd (1 : ℤ))

/-- Conjugate `t_{p} = g(p)⁻¹ * t * g(p)` representing configuration `p : ℤ × ℤ`. -/
def mbConjT (p : ℤ × ℤ) : ModBase :=
  (mbG p)⁻¹ * mbT * mbG p

/-- Retraction `ModBase →* Multiplicative (ℤ × ℤ)` killing `t`. -/
def mbProj : ModBase →* Multiplicative (ℤ × ℤ) :=
  Coprod.fst

@[simp]
theorem mbG_zero : mbG (0, 0) = 1 := by
  change Coprod.inl (Multiplicative.ofAdd (0 : ℤ × ℤ)) = 1
  simp

@[simp]
theorem mbG_add (p q : ℤ × ℤ) : mbG (p + q) = mbG p * mbG q := by
  simp [mbG, ofAdd_add]

@[simp]
theorem mbG_neg (p : ℤ × ℤ) : mbG (-p) = (mbG p)⁻¹ := by
  simp [mbG, ofAdd_neg]

theorem mbG_eq_zpow (p : ℤ × ℤ) : mbG p = mbX ^ p.1 * mbY ^ p.2 := by
  rcases p with ⟨a, b⟩
  simp only [mbX, mbY, mbG, ← map_zpow, ← map_mul, ← ofAdd_zsmul, ← ofAdd_add]
  congr 1
  ext <;> simp

@[simp]
theorem mbProj_mbG (p : ℤ × ℤ) : mbProj (mbG p) = Multiplicative.ofAdd p := rfl

@[simp]
theorem mbProj_mbT : mbProj mbT = 1 := rfl

@[simp]
theorem mbProj_mbConjT (p : ℤ × ℤ) : mbProj (mbConjT p) = 1 := by
  simp [mbConjT]

theorem mbG_conj_mbConjT (q p : ℤ × ℤ) :
    mbG q * mbConjT p * (mbG q)⁻¹ = mbConjT (p - q) := by
  simp only [mbConjT, ← mbG_neg, mul_assoc]
  rw [← mul_assoc (mbG q), ← mbG_add, ← mbG_add]
  have h1 : q + -p = -(p - q) := by ext <;> dsimp <;> omega
  have h2 : p + -q = p - q := by ext <;> dsimp <;> omega
  rw [h1, h2]

theorem mbConjT_mem_ker (p : ℤ × ℤ) : mbConjT p ∈ mbProj.ker := by
  simp [MonoidHom.mem_ker]

/-- Homomorphism `FreeGroup (ℤ × ℤ) →* ModBase` sending `of p ↦ mbConjT p`. -/
def mbConjTHom : FreeGroup (ℤ × ℤ) →* ModBase :=
  FreeGroup.lift mbConjT

private abbrev MBWord := CoprodI.Word (TwoFam (Multiplicative (ℤ × ℤ)) (Multiplicative ℤ))

theorem mbConjTHom_injective : Function.Injective mbConjTHom := by
  let e := coprodEquivCoprodI (Multiplicative (ℤ × ℤ)) (Multiplicative ℤ)
  let _ : MulAction ModBase MBWord := MulAction.compHom MBWord e.toMonoidHom
  let startsPos (w : MBWord) : Prop :=
    ∃ (k : ℤ) (rest : List (Σ b, TwoFam (Multiplicative (ℤ × ℤ)) (Multiplicative ℤ) b)),
      0 < k ∧ w.toList = ⟨true, Multiplicative.ofAdd k⟩ :: rest
  let startsNeg (w : MBWord) : Prop :=
    ∃ (k : ℤ) (rest : List (Σ b, TwoFam (Multiplicative (ℤ × ℤ)) (Multiplicative ℤ) b)),
      k < 0 ∧ w.toList = ⟨true, Multiplicative.ofAdd k⟩ :: rest
  let X (p : ℤ × ℤ) : Set MBWord :=
    if p = (0, 0) then {w | startsPos w}
    else {w | ∃ (k : ℤ) (rest : List _),
      0 < k ∧ w.toList = ⟨false, Multiplicative.ofAdd (-p)⟩ :: ⟨true, Multiplicative.ofAdd k⟩ :: rest}
  let Y (p : ℤ × ℤ) : Set MBWord :=
    if p = (0, 0) then {w | startsNeg w}
    else {w | ∃ (k : ℤ) (rest : List _),
      k < 0 ∧ w.toList = ⟨false, Multiplicative.ofAdd (-p)⟩ :: ⟨true, Multiplicative.ofAdd k⟩ :: rest}
  have hsmul_false : ∀ (q : ℤ × ℤ) (w : MBWord),
      (mbG q : ModBase) • w =
        CoprodI.of (M := TwoFam (Multiplicative (ℤ × ℤ)) (Multiplicative ℤ)) (i := false)
          (Multiplicative.ofAdd q) • w := fun q w => by
    change e (mbG q) • w = _
    rfl
  have hpos_of_not_neg : ∀ w : MBWord, ¬ startsNeg w → startsPos (mbT • w) := by
    intro w hw
    have ht : mbT • w =
        CoprodI.of (M := TwoFam (Multiplicative (ℤ × ℤ)) (Multiplicative ℤ)) (i := true)
          (Multiplicative.ofAdd (1 : ℤ)) • w := by
      change e mbT • w = _
      rfl
    rw [ht, CoprodI.Word.of_smul_def]
    rcases w with ⟨l, hne, hch⟩
    cases l with
    | nil =>
      have hfst : CoprodI.Word.fstIdx ⟨[], hne, hch⟩ ≠ some true := by simp [CoprodI.Word.fstIdx]
      rw [CoprodI.Word.equivPair_eq_of_fstIdx_ne hfst]
      have h1_ne : (Multiplicative.ofAdd (1 : ℤ) : Multiplicative ℤ) ≠ 1 := fun h => by
        have := Multiplicative.ofAdd.injective (h.trans ofAdd_zero.symm); omega
      refine ⟨1, [], by omega, ?_⟩
      rw [CoprodI.Word.rcons]
      dsimp only
      rw [mul_one, dite_eq_right h1_ne]
      rfl
    | cons hd tl =>
      rcases hd with ⟨b, val⟩
      cases b
      · have hfst : CoprodI.Word.fstIdx ⟨⟨false, val⟩ :: tl, hne, hch⟩ ≠ some true := by
          simp [CoprodI.Word.fstIdx]
        rw [CoprodI.Word.equivPair_eq_of_fstIdx_ne hfst]
        have h1_ne : (Multiplicative.ofAdd (1 : ℤ) : Multiplicative ℤ) ≠ 1 := fun h => by
          have := Multiplicative.ofAdd.injective (h.trans ofAdd_zero.symm); omega
        refine ⟨1, ⟨false, val⟩ :: tl, by omega, ?_⟩
        rw [CoprodI.Word.rcons]
        dsimp only
        rw [mul_one, dite_eq_right h1_ne]
        rfl
      · let k : ℤ := Multiplicative.toAdd val
        have hval : val = Multiplicative.ofAdd k := (ofAdd_toAdd val).symm
        have hk0 : k ≠ 0 := by
          intro hk
          apply hne ⟨true, val⟩ List.mem_cons_self
          simp [hval, hk]
        have hk_pos : 0 < k := by
          by_contra hle
          apply hw
          exact ⟨k, tl, by omega, by simp [hval]⟩
        have hch_tl : tl.IsChain (fun l l' => l.1 ≠ l'.1) := (List.isChain_cons.1 hch).2
        have htail_fst : CoprodI.Word.fstIdx
            ⟨tl, fun x hx => hne x (List.mem_cons_of_mem _ hx), hch_tl⟩ ≠ some true := by
          rw [CoprodI.Word.fstIdx_ne_iff]
          intro x hx
          cases tl with
          | nil => simp at hx
          | cons y tl' =>
            simp only [List.head?_cons, Option.mem_def, Option.some.injEq] at hx
            subst hx
            exact (List.isChain_cons_cons.1 hch).1
        have heq_p : CoprodI.Word.equivPair (M := TwoFam _ _) true ⟨⟨true, val⟩ :: tl, hne, hch⟩ =
            ⟨val, ⟨tl, fun x hx => hne x (List.mem_cons_of_mem _ hx), hch_tl⟩, htail_fst⟩ := by
          apply ((CoprodI.Word.equivPair true).eq_symm_apply).mp
          rw [CoprodI.Word.equivPair_symm]
          have hne_val : val ≠ 1 := hne ⟨true, val⟩ List.mem_cons_self
          ext
          simp [CoprodI.Word.rcons, hne_val]
        rw [heq_p]
        have h1k : Multiplicative.ofAdd (1 : ℤ) * val = Multiplicative.ofAdd (1 + k) := by
          rw [hval, ← ofAdd_add]
        have h1k_ne : (Multiplicative.ofAdd (1 + k) : Multiplicative ℤ) ≠ 1 := by
          intro h
          have : 1 + k = 0 := Multiplicative.ofAdd.injective (h.trans ofAdd_zero.symm)
          omega
        refine ⟨1 + k, tl, by omega, ?_⟩
        rw [CoprodI.Word.rcons]
        dsimp only
        rw [h1k, dite_eq_right h1k_ne]
        rfl
  have hneg_of_not_pos : ∀ w : MBWord, ¬ startsPos w → startsNeg (mbT⁻¹ • w) := by
    intro w hw
    have ht : mbT⁻¹ • w =
        CoprodI.of (M := TwoFam (Multiplicative (ℤ × ℤ)) (Multiplicative ℤ)) (i := true)
          (Multiplicative.ofAdd (-1 : ℤ)) • w := by
      change e mbT⁻¹ • w = _
      rw [map_inv]
      change (CoprodI.of (M := TwoFam (Multiplicative (ℤ × ℤ)) (Multiplicative ℤ)) (i := true)
        (Multiplicative.ofAdd (1 : ℤ)))⁻¹ • w = _
      rw [← map_inv, ← ofAdd_neg]
    rw [ht, CoprodI.Word.of_smul_def]
    rcases w with ⟨l, hne, hch⟩
    cases l with
    | nil =>
      have hfst : CoprodI.Word.fstIdx ⟨[], hne, hch⟩ ≠ some true := by simp [CoprodI.Word.fstIdx]
      rw [CoprodI.Word.equivPair_eq_of_fstIdx_ne hfst]
      have h1_ne : (Multiplicative.ofAdd (-1 : ℤ) : Multiplicative ℤ) ≠ 1 := fun h => by
        have := Multiplicative.ofAdd.injective (h.trans ofAdd_zero.symm); omega
      refine ⟨-1, [], by omega, ?_⟩
      rw [CoprodI.Word.rcons]
      dsimp only
      rw [mul_one, dite_eq_right h1_ne]
      rfl
    | cons hd tl =>
      rcases hd with ⟨b, val⟩
      cases b
      · have hfst : CoprodI.Word.fstIdx ⟨⟨false, val⟩ :: tl, hne, hch⟩ ≠ some true := by
          simp [CoprodI.Word.fstIdx]
        rw [CoprodI.Word.equivPair_eq_of_fstIdx_ne hfst]
        have h1_ne : (Multiplicative.ofAdd (-1 : ℤ) : Multiplicative ℤ) ≠ 1 := fun h => by
          have := Multiplicative.ofAdd.injective (h.trans ofAdd_zero.symm); omega
        refine ⟨-1, ⟨false, val⟩ :: tl, by omega, ?_⟩
        rw [CoprodI.Word.rcons]
        dsimp only
        rw [mul_one, dite_eq_right h1_ne]
        rfl
      · let k : ℤ := Multiplicative.toAdd val
        have hval : val = Multiplicative.ofAdd k := (ofAdd_toAdd val).symm
        have hk0 : k ≠ 0 := by
          intro hk
          apply hne ⟨true, val⟩ List.mem_cons_self
          simp [hval, hk]
        have hk_neg : k < 0 := by
          by_contra hge
          apply hw
          exact ⟨k, tl, by omega, by simp [hval]⟩
        have hch_tl : tl.IsChain (fun l l' => l.1 ≠ l'.1) := (List.isChain_cons.1 hch).2
        have htail_fst : CoprodI.Word.fstIdx
            ⟨tl, fun x hx => hne x (List.mem_cons_of_mem _ hx), hch_tl⟩ ≠ some true := by
          rw [CoprodI.Word.fstIdx_ne_iff]
          intro x hx
          cases tl with
          | nil => simp at hx
          | cons y tl' =>
            simp only [List.head?_cons, Option.mem_def, Option.some.injEq] at hx
            subst hx
            exact (List.isChain_cons_cons.1 hch).1
        have heq_p : CoprodI.Word.equivPair (M := TwoFam _ _) true ⟨⟨true, val⟩ :: tl, hne, hch⟩ =
            ⟨val, ⟨tl, fun x hx => hne x (List.mem_cons_of_mem _ hx), hch_tl⟩, htail_fst⟩ := by
          apply ((CoprodI.Word.equivPair true).eq_symm_apply).mp
          rw [CoprodI.Word.equivPair_symm]
          have hne_val : val ≠ 1 := hne ⟨true, val⟩ List.mem_cons_self
          ext
          simp [CoprodI.Word.rcons, hne_val]
        rw [heq_p]
        have h1k : Multiplicative.ofAdd (-1 : ℤ) * val = Multiplicative.ofAdd (-1 + k) := by
          rw [hval, ← ofAdd_add]
        have h1k_ne : (Multiplicative.ofAdd (-1 + k) : Multiplicative ℤ) ≠ 1 := by
          intro h
          have : -1 + k = 0 := Multiplicative.ofAdd.injective (h.trans ofAdd_zero.symm)
          omega
        refine ⟨-1 + k, tl, by omega, ?_⟩
        rw [CoprodI.Word.rcons]
        dsimp only
        rw [h1k, dite_eq_right h1k_ne]
        rfl
  have hconj_X : ∀ (p : ℤ × ℤ) (w : MBWord), startsPos w → (mbG p)⁻¹ • w ∈ X p := by
    intro p w ⟨k, rest, hk, hlist⟩
    rw [← mbG_neg]
    by_cases hp : p = (0, 0)
    · subst hp
      change startsPos (mbG (-((0 : ℤ), (0 : ℤ))) • w)
      rw [show -((0 : ℤ), (0 : ℤ)) = (0, 0) from rfl, mbG_zero, one_smul]
      exact ⟨k, rest, hk, hlist⟩
    · simp only [X, hp, ↓reduceIte, Set.mem_ofPred_eq]
      rw [hsmul_false, CoprodI.Word.of_smul_def]
      have hfst : w.fstIdx ≠ some false := by
        simp [CoprodI.Word.fstIdx, hlist]
      rw [CoprodI.Word.equivPair_eq_of_fstIdx_ne hfst]
      have hne_p : (Multiplicative.ofAdd (-p) : Multiplicative (ℤ × ℤ)) ≠ 1 := by
        intro h
        apply hp
        have : -p = (0, 0) := Multiplicative.ofAdd.injective (h.trans ofAdd_zero.symm)
        exact neg_eq_zero.mp this
      refine ⟨k, rest, hk, ?_⟩
      rw [CoprodI.Word.rcons]
      dsimp only
      rw [mul_one, dite_eq_right hne_p]
      exact congrArg (List.cons _) hlist
  have hconj_Y : ∀ (p : ℤ × ℤ) (w : MBWord), startsNeg w → (mbG p)⁻¹ • w ∈ Y p := by
    intro p w ⟨k, rest, hk, hlist⟩
    rw [← mbG_neg]
    by_cases hp : p = (0, 0)
    · subst hp
      change startsNeg (mbG (-((0 : ℤ), (0 : ℤ))) • w)
      rw [show -((0 : ℤ), (0 : ℤ)) = (0, 0) from rfl, mbG_zero, one_smul]
      exact ⟨k, rest, hk, hlist⟩
    · simp only [Y, hp, ↓reduceIte, Set.mem_ofPred_eq]
      rw [hsmul_false, CoprodI.Word.of_smul_def]
      have hfst : w.fstIdx ≠ some false := by
        simp [CoprodI.Word.fstIdx, hlist]
      rw [CoprodI.Word.equivPair_eq_of_fstIdx_ne hfst]
      have hne_p : (Multiplicative.ofAdd (-p) : Multiplicative (ℤ × ℤ)) ≠ 1 := by
        intro h
        apply hp
        have : -p = (0, 0) := Multiplicative.ofAdd.injective (h.trans ofAdd_zero.symm)
        exact neg_eq_zero.mp this
      refine ⟨k, rest, hk, ?_⟩
      rw [CoprodI.Word.rcons]
      dsimp only
      rw [mul_one, dite_eq_right hne_p]
      exact congrArg (List.cons _) hlist
  have hgp_not_neg : ∀ (p : ℤ × ℤ) (w : MBWord), w ∉ Y p → ¬ startsNeg (mbG p • w) := by
    intro p w hw hneg
    apply hw
    have h1 := hconj_Y p (mbG p • w) hneg
    simpa [← mul_smul] using h1
  have hgp_not_pos : ∀ (p : ℤ × ℤ) (w : MBWord), w ∉ X p → ¬ startsPos (mbG p • w) := by
    intro p w hw hpos
    apply hw
    have h1 := hconj_X p (mbG p • w) hpos
    simpa [← mul_smul] using h1
  refine FreeGroup.injective_lift_of_ping_pong mbConjT X Y ?_ ?_ ?_ ?_ ?_ ?_
  · intro p
    refine ⟨(mbG p)⁻¹ • (mbT • CoprodI.Word.empty), hconj_X p _ (hpos_of_not_neg _ ?_)⟩
    rintro ⟨_, _, _, h⟩
    simp at h
  · intro p q hpq
    change Disjoint (X p) (X q)
    rw [Set.disjoint_left]
    intro w hwp hwq
    by_cases hp : p = (0, 0) <;> by_cases hq : q = (0, 0)
    · exact hpq (hp.trans hq.symm)
    · simp only [X, hp, hq, ↓reduceIte, Set.mem_ofPred_eq] at hwp hwq
      rcases hwp with ⟨_, _, _, h1⟩; rcases hwq with ⟨_, _, _, h2⟩
      rw [h1] at h2; simp at h2
    · simp only [X, hp, hq, ↓reduceIte, Set.mem_ofPred_eq] at hwp hwq
      rcases hwp with ⟨_, _, _, h1⟩; rcases hwq with ⟨_, _, _, h2⟩
      rw [h1] at h2; simp at h2
    · simp only [X, hp, hq, ↓reduceIte, Set.mem_ofPred_eq] at hwp hwq
      rcases hwp with ⟨_, _, _, h1⟩; rcases hwq with ⟨_, _, _, h2⟩
      rw [h1] at h2
      simp only [List.cons.injEq, Sigma.mk.injEq, heq_eq_eq, true_and] at h2
      exact hpq (neg_inj.mp (Multiplicative.ofAdd.injective h2.1))
  · intro p q hpq
    change Disjoint (Y p) (Y q)
    rw [Set.disjoint_left]
    intro w hwp hwq
    by_cases hp : p = (0, 0) <;> by_cases hq : q = (0, 0)
    · exact hpq (hp.trans hq.symm)
    · simp only [Y, hp, hq, ↓reduceIte, Set.mem_ofPred_eq] at hwp hwq
      rcases hwp with ⟨_, _, _, h1⟩; rcases hwq with ⟨_, _, _, h2⟩
      rw [h1] at h2; simp at h2
    · simp only [Y, hp, hq, ↓reduceIte, Set.mem_ofPred_eq] at hwp hwq
      rcases hwp with ⟨_, _, _, h1⟩; rcases hwq with ⟨_, _, _, h2⟩
      rw [h1] at h2; simp at h2
    · simp only [Y, hp, hq, ↓reduceIte, Set.mem_ofPred_eq] at hwp hwq
      rcases hwp with ⟨_, _, _, h1⟩; rcases hwq with ⟨_, _, _, h2⟩
      rw [h1] at h2
      simp only [List.cons.injEq, Sigma.mk.injEq, heq_eq_eq, true_and] at h2
      exact hpq (neg_inj.mp (Multiplicative.ofAdd.injective h2.1))
  · intro p q
    rw [Set.disjoint_left]
    intro w hwp hwq
    by_cases hp : p = (0, 0) <;> by_cases hq : q = (0, 0)
    · simp only [X, Y, hp, hq, ↓reduceIte, Set.mem_ofPred_eq] at hwp hwq
      rcases hwp with ⟨k₁, _, hk₁, h1⟩; rcases hwq with ⟨k₂, _, hk₂, h2⟩
      rw [h1] at h2
      simp only [List.cons.injEq, Sigma.mk.injEq, heq_eq_eq, true_and] at h2
      have := Multiplicative.ofAdd.injective h2.1; omega
    · simp only [X, Y, hp, hq, ↓reduceIte, Set.mem_ofPred_eq] at hwp hwq
      rcases hwp with ⟨_, _, _, h1⟩; rcases hwq with ⟨_, _, _, h2⟩
      rw [h1] at h2; simp at h2
    · simp only [X, Y, hp, hq, ↓reduceIte, Set.mem_ofPred_eq] at hwp hwq
      rcases hwp with ⟨_, _, _, h1⟩; rcases hwq with ⟨_, _, _, h2⟩
      rw [h1] at h2; simp at h2
    · simp only [X, Y, hp, hq, ↓reduceIte, Set.mem_ofPred_eq] at hwp hwq
      rcases hwp with ⟨k₁, _, hk₁, h1⟩; rcases hwq with ⟨k₂, _, hk₂, h2⟩
      rw [h1] at h2
      simp only [List.cons.injEq, Sigma.mk.injEq, heq_eq_eq, true_and] at h2
      have := Multiplicative.ofAdd.injective h2.2.1; omega
  · intro p
    rintro _ ⟨w, hw, rfl⟩
    simp only [mbConjT, mul_smul]
    exact hconj_X p _ (hpos_of_not_neg _ (hgp_not_neg p w hw))
  · intro p
    rintro _ ⟨w, hw, rfl⟩
    have hinv : (mbConjT p)⁻¹ = (mbG p)⁻¹ * mbT⁻¹ * mbG p := by
      simp [mbConjT, mul_assoc]
    rw [Pi.inv_apply, hinv]
    simp only [mul_smul]
    exact hconj_Y p _ (hneg_of_not_pos _ (hgp_not_pos p w hw))

theorem mbConjTHom_range : mbConjTHom.range = mbProj.ker := by
  apply le_antisymm
  · rintro _ ⟨w, rfl⟩
    induction w using FreeGroup.induction_on with
    | one => simp
    | of p => simp [mbConjTHom]
    | inv_of p _ =>
      rw [map_inv]
      exact inv_mem (by simp [mbConjTHom])
    | mul x y hx hy =>
      rw [map_mul]
      exact mul_mem hx hy
  · have hconj_range : ∀ (q : ℤ × ℤ) (z : ModBase),
        z ∈ mbConjTHom.range → mbG q * z * (mbG q)⁻¹ ∈ mbConjTHom.range := by
      rintro q _ ⟨w, rfl⟩
      refine ⟨FreeGroup.map (fun p => p - q) w, ?_⟩
      induction w using FreeGroup.induction_on with
      | one => simp
      | of p =>
        simp only [FreeGroup.map.of, mbConjTHom, FreeGroup.lift_apply_of]
        exact (mbG_conj_mbConjT q p).symm
      | inv_of p _ =>
        simp only [map_inv, FreeGroup.map.of, mbConjTHom, FreeGroup.lift_apply_of]
        have := congrArg Inv.inv (mbG_conj_mbConjT q p).symm
        simpa [mul_assoc] using this
      | mul x y ihx ihy =>
        simp only [map_mul]
        calc
          mbConjTHom (FreeGroup.map (fun p => p - q) x) *
              mbConjTHom (FreeGroup.map (fun p => p - q) y)
              = (mbG q * mbConjTHom x * (mbG q)⁻¹) * (mbG q * mbConjTHom y * (mbG q)⁻¹) := by
                rw [ihx, ihy]
          _ = mbG q * (mbConjTHom x * mbConjTHom y) * (mbG q)⁻¹ := by group
    have hmain : ∀ x : ModBase, x * (Coprod.inl (mbProj x))⁻¹ ∈ mbConjTHom.range := by
      intro x
      induction x using Coprod.induction_on' with
      | one => simp
      | inl_mul a y ih =>
        have hstep : Coprod.inl a * y * (Coprod.inl (mbProj (Coprod.inl a * y)))⁻¹ =
            mbG (Multiplicative.toAdd a) * (y * (Coprod.inl (mbProj y))⁻¹) *
              (mbG (Multiplicative.toAdd a))⁻¹ := by
          have ha : Coprod.inl a = mbG (Multiplicative.toAdd a) := by simp [mbG]
          have hfst : Coprod.fst (Coprod.inl a : ModBase) = a := Coprod.fst_apply_inl a
          simp only [mbProj, map_mul, hfst, mul_inv_rev, mul_assoc]
          rw [ha]
        rw [hstep]
        exact hconj_range (Multiplicative.toAdd a) _ ih
      | inr_mul b y ih =>
        have hb : Coprod.inr b = mbT ^ (Multiplicative.toAdd b) := by
          simp [mbT, ← map_zpow, ← ofAdd_zsmul]
        have hmem_b : Coprod.inr b ∈ mbConjTHom.range := by
          rw [hb]
          refine ⟨FreeGroup.of (0, 0) ^ (Multiplicative.toAdd b), ?_⟩
          simp [mbConjTHom, mbConjT]
        have hstep : Coprod.inr b * y * (Coprod.inl (mbProj (Coprod.inr b * y)))⁻¹ =
            Coprod.inr b * (y * (Coprod.inl (mbProj y))⁻¹) := by
          simp [mbProj, mul_assoc]
        rw [hstep]
        exact mul_mem hmem_b ih
    intro x hx
    have := hmain x
    rw [MonoidHom.mem_ker.mp hx, map_one, inv_one, mul_one] at this
    exact this

/-- Isomorphism `FreeGroup (ℤ × ℤ) ≃* mbProj.ker` sending `of p ↦ mbConjT p`. -/
noncomputable def kerProjBasis : FreeGroup (ℤ × ℤ) ≃* mbProj.ker :=
  (MulEquiv.ofBijective mbConjTHom.rangeRestrict
    ⟨fun _ _ h => mbConjTHom_injective (congrArg Subtype.val h),
     mbConjTHom.rangeRestrict_surjective⟩).trans
    (MulEquiv.subgroupCongr mbConjTHom_range)

@[simp]
theorem kerProjBasis_apply (w : FreeGroup (ℤ × ℤ)) :
    (kerProjBasis w : ModBase) = mbConjTHom w := rfl

end ModBase

/-! ### Part 4: The Affine Group `AffQ` for `BS(1, 2)` -/

section AffQ

/-- The 2×2 affine group `ℚˣ ⋉ ℚ`, represented as pairs `(a, t)` with multiplication
`(a₁, t₁) * (a₂, t₂) = (a₁ * a₂, t₁ + a₁ * t₂)`. -/
structure AffQ where
  scale : ℚˣ
  shift : ℚ

namespace AffQ

@[ext]
theorem ext {x y : AffQ} (h1 : x.scale = y.scale) (h2 : x.shift = y.shift) : x = y := by
  cases x; cases y; simp_all

instance : One AffQ := ⟨⟨1, 0⟩⟩
instance : Mul AffQ := ⟨fun x y => ⟨x.scale * y.scale, x.shift + (x.scale : ℚ) * y.shift⟩⟩
instance : Inv AffQ := ⟨fun x => ⟨x.scale⁻¹, -((x.scale⁻¹ : ℚˣ) : ℚ) * x.shift⟩⟩

@[simp] theorem one_scale : (1 : AffQ).scale = 1 := rfl
@[simp] theorem one_shift : (1 : AffQ).shift = 0 := rfl
@[simp] theorem mul_scale (x y : AffQ) : (x * y).scale = x.scale * y.scale := rfl
@[simp] theorem mul_shift (x y : AffQ) :
    (x * y).shift = x.shift + (x.scale : ℚ) * y.shift := rfl
@[simp] theorem inv_scale (x : AffQ) : x⁻¹.scale = x.scale⁻¹ := rfl
@[simp] theorem inv_shift (x : AffQ) :
    x⁻¹.shift = -((x.scale⁻¹ : ℚˣ) : ℚ) * x.shift := rfl

instance : Group AffQ where
  mul_assoc a b c := by
    ext
    · simp [mul_assoc]
    · simp; ring
  one_mul a := by
    ext
    · simp
    · simp
  mul_one a := by
    ext
    · simp
    · simp
  inv_mul_cancel a := by
    ext
    · simp
    · simp

/-- Translation generator `b = (1, 1)` of `BS(1, 2) ↪ AffQ`. -/
def genB : AffQ := ⟨1, 1⟩

/-- Scaling generator `c = (1/2, 0)` of `BS(1, 2) ↪ AffQ`. -/
def genC : AffQ := ⟨Units.mk0 (1 / 2 : ℚ) (by norm_num), 0⟩

theorem conj_rel : genC⁻¹ * genB * genC = genB ^ (2 : ℕ) := by
  rw [sq]
  ext
  · simp [genB, genC]
  · simp [genB, genC, Units.val_inv_eq_inv_val]
    norm_num

theorem genB_zpow (k : ℤ) : genB ^ k = ⟨1, k⟩ := by
  have hnat : ∀ n : ℕ, genB ^ n = ⟨1, (n : ℚ)⟩ := by
    intro n
    induction n with
    | zero => ext <;> simp
    | succ n ih =>
      rw [pow_succ, ih]
      ext
      · simp [genB]
      · simp [genB]
  cases k with
  | ofNat n =>
    rw [Int.ofNat_eq_natCast, zpow_natCast, hnat n]
    rfl
  | negSucc n =>
    rw [zpow_negSucc, hnat (n + 1)]
    ext
    · simp
    · simp [Int.negSucc_eq]

theorem genC_zpow (k : ℤ) : genC ^ k = ⟨(Units.mk0 (1 / 2 : ℚ) (by norm_num)) ^ k, 0⟩ := by
  have hnat : ∀ n : ℕ, genC ^ n = ⟨(Units.mk0 (1 / 2 : ℚ) (by norm_num)) ^ n, 0⟩ := by
    intro n
    induction n with
    | zero => ext <;> simp
    | succ n ih =>
      rw [pow_succ, ih]
      ext
      · simp [genC, pow_succ]
      · simp [genC]
  cases k with
  | ofNat n =>
    rw [Int.ofNat_eq_natCast, zpow_natCast, hnat n, zpow_natCast]
  | negSucc n =>
    rw [zpow_negSucc, hnat (n + 1), zpow_negSucc]
    ext
    · simp
    · simp

theorem genB_zpow_eq_one_iff (k : ℤ) : genB ^ k = 1 ↔ k = 0 := by
  rw [genB_zpow]
  constructor
  · intro h
    have h2 : (k : ℚ) = 0 := congrArg AffQ.shift h
    exact_mod_cast h2
  · rintro rfl; ext <;> simp

theorem genC_zpow_eq_one_iff (k : ℤ) : genC ^ k = 1 ↔ k = 0 := by
  rw [genC_zpow]
  constructor
  · intro h
    have hscale : (Units.mk0 (1 / 2 : ℚ) (by norm_num)) ^ k = 1 := congrArg AffQ.scale h
    have hq : (1 / 2 : ℚ) ^ k = 1 := by
      have := congrArg Units.val hscale
      simpa using this
    by_contra hk
    rcases lt_or_gt_of_ne hk with hlt | hgt
    · have h1 : (2 : ℚ) ^ (-k).toNat = 1 := by
        have hinv : ((1 / 2 : ℚ) ^ k)⁻¹ = 1 := by rw [hq]; norm_num
        rw [← zpow_neg, show (-k : ℤ) = ((-k).toNat : ℤ) by omega, zpow_natCast] at hinv
        simpa [one_div, inv_pow] using hinv
      have hgt1 : (1 : ℚ) < (2 : ℚ) ^ (-k).toNat := by
        have hm : 1 ≤ (-k).toNat := by omega
        calc (1 : ℚ) < 2 ^ 1 := by norm_num
          _ ≤ 2 ^ (-k).toNat := pow_le_pow_right₀ (by norm_num) hm
      linarith
    · have hm : 1 ≤ k.toNat := by omega
      have h1 : (1 / 2 : ℚ) ^ k.toNat = 1 := by
        rw [show k = (k.toNat : ℤ) by omega, zpow_natCast] at hq
        exact hq
      have hlt1 : (1 / 2 : ℚ) ^ k.toNat < 1 := by
        calc (1 / 2 : ℚ) ^ k.toNat ≤ (1 / 2 : ℚ) ^ 1 :=
              pow_le_pow_of_le_one (by norm_num) (by norm_num) hm
          _ < 1 := by norm_num
      linarith
  · rintro rfl; ext <;> simp

theorem genB_zpow_eq_genC_zpow_iff (r k : ℤ) : genB ^ r = genC ^ k ↔ r = 0 ∧ k = 0 := by
  rw [genB_zpow, genC_zpow]
  constructor
  · intro h
    have hr : (r : ℚ) = 0 := congrArg AffQ.shift h
    have hr0 : r = 0 := by exact_mod_cast hr
    have hscale : (Units.mk0 (1 / 2 : ℚ) (by norm_num)) ^ k = 1 := (congrArg AffQ.scale h).symm
    have hk0 : k = 0 := (genC_zpow_eq_one_iff k).mp (by rw [genC_zpow]; exact AffQ.ext hscale rfl)
    exact ⟨hr0, hk0⟩
  · rintro ⟨rfl, rfl⟩; ext <;> simp

end AffQ

end AffQ

/-! ### Part 5: Infinite Order of `[w, z]` in `K ∗ ℤ` (for Rabin Step 0) -/

section CommutatorOrder

private def commRepList {K : Type} [Group K] (w : K) :
    ℕ → List (Σ b, TwoFam K (Multiplicative ℤ) b)
  | 0 => []
  | m + 1 =>
    [⟨false, w⟩, ⟨true, Multiplicative.ofAdd (1 : ℤ)⟩,
     ⟨false, w⁻¹⟩, ⟨true, Multiplicative.ofAdd (-1 : ℤ)⟩] ++ commRepList w m

/-- In `K ∗ Multiplicative ℤ`, if `w ≠ 1` in `K`, then `[inl w, inr 1]` has infinite order. -/
theorem commutator_zpow_eq_one {K : Type} [Group K] {w : K} (hw : w ≠ 1) (k : ℤ) :
    let z : Coprod K (Multiplicative ℤ) := Coprod.inr (Multiplicative.ofAdd (1 : ℤ))
    (Coprod.inl w * z * (Coprod.inl w)⁻¹ * z⁻¹) ^ k = 1 → k = 0 := by
  classical
  intro z hk
  let e := coprodEquivCoprodI K (Multiplicative ℤ)
  have hnat : ∀ n : ℕ, 0 < n → (Coprod.inl w * z * (Coprod.inl w)⁻¹ * z⁻¹) ^ n ≠ 1 := by
    intro n hn heq
    have hne_one : ∀ m, ∀ l ∈ commRepList w m, l.2 ≠ 1 := by
      intro m
      induction m with
      | zero => simp [commRepList]
      | succ m ih =>
        intro l hl
        simp only [commRepList, List.mem_append, List.mem_cons, List.not_mem_nil, or_false] at hl
        rcases hl with (rfl | rfl | rfl | rfl) | hl
        · exact hw
        · intro h
          have : (1 : ℤ) = 0 := Multiplicative.ofAdd.injective (h.trans ofAdd_zero.symm)
          omega
        · exact inv_ne_one.mpr hw
        · intro h
          have : (-1 : ℤ) = 0 := Multiplicative.ofAdd.injective (h.trans ofAdd_zero.symm)
          omega
        · exact ih l hl
    have hhead : ∀ m, ∀ x ∈ (commRepList w m).head?, x.1 = false := by
      intro m
      cases m with
      | zero => simp [commRepList]
      | succ m => simp [commRepList]
    have hchain : ∀ m, (commRepList w m).IsChain (fun x y => x.1 ≠ y.1) := by
      intro m
      induction m with
      | zero => exact List.isChain_nil
      | succ m ih =>
        simp only [commRepList, List.cons_append, List.nil_append]
        refine List.isChain_cons_cons.2 ⟨by simp, List.isChain_cons_cons.2 ⟨by simp,
          List.isChain_cons_cons.2 ⟨by simp, List.isChain_cons.2 ⟨?_, ih⟩⟩⟩⟩
        intro y hy
        rw [hhead m y hy]
        simp
    have hprod : ∀ m,
        ((commRepList w m).map fun s => CoprodI.of s.2).prod =
        e ((Coprod.inl w * z * (Coprod.inl w)⁻¹ * z⁻¹) ^ m) := by
      intro m
      induction m with
      | zero => simp [commRepList]
      | succ m ih =>
        simp only [commRepList, List.map_append, List.prod_append, List.map_cons,
          List.map_nil, List.prod_cons, List.prod_nil, mul_one, ih, pow_succ', map_mul]
        have hz_inv : e z⁻¹ = CoprodI.of (M := TwoFam K (Multiplicative ℤ)) (i := true)
            (Multiplicative.ofAdd (-1 : ℤ)) := by
          simp [e, z, ← map_inv, ← ofAdd_neg]
        simp [e, z, hz_inv, mul_assoc]
    let rw : CoprodI.Word (TwoFam K (Multiplicative ℤ)) := ⟨commRepList w n, hne_one n, hchain n⟩
    have hrw_prod : rw.prod = 1 := by
      change ((commRepList w n).map fun s => CoprodI.of s.2).prod = 1
      rw [hprod n, heq, map_one]
    have hempty : rw = CoprodI.Word.empty :=
      CoprodI.Word.equiv.symm.injective (by simpa [CoprodI.Word.equiv] using hrw_prod)
    have hlen := congrArg (fun u => u.toList.length) hempty
    cases n with
    | zero => omega
    | succ m => simp [rw, commRepList] at hlen
  by_contra hk0
  rcases lt_or_gt_of_ne hk0 with hlt | hgt
  · have hinv : (Coprod.inl w * z * (Coprod.inl w)⁻¹ * z⁻¹) ^ (-k).toNat = 1 := by
      have := congrArg Inv.inv hk
      rw [inv_one, ← zpow_neg, show (-k : ℤ) = ((-k).toNat : ℤ) by omega, zpow_natCast] at this
      exact this
    exact hnat (-k).toNat (by omega) hinv
  · have hpos : (Coprod.inl w * z * (Coprod.inl w)⁻¹ * z⁻¹) ^ k.toNat = 1 := by
      rw [show k = (k.toNat : ℤ) by omega, zpow_natCast] at hk
      exact hk
    exact hnat k.toNat (by omega) hpos

end CommutatorOrder

/-! ### Part 6: Rabin's Free Subgroups `P` and `Q` in `M ∗ ℤ` -/

section RabinFreeSubgroups

variable {M : Type} [Group M]

/-- Rabin's `p_i = f^(i+1) * b * f^(-(i+1))` in `M ∗ Multiplicative ℤ`. -/
def rabinP {k : ℕ} (b : M) (i : Fin k) : Coprod M (Multiplicative ℤ) :=
  let f : Coprod M (Multiplicative ℤ) := Coprod.inr (Multiplicative.ofAdd (1 : ℤ))
  f ^ ((i.val + 1 : ℕ) : ℤ) * Coprod.inl b * f ^ (-((i.val + 1 : ℕ) : ℤ))

/-- Rabin's `q_i = f^(i+1) * b * f * b * f^(-(i+1)) * g_i` in `M ∗ Multiplicative ℤ`. -/
def rabinQ {k : ℕ} (b : M) (g : Fin k → M) (i : Fin k) : Coprod M (Multiplicative ℤ) :=
  let f : Coprod M (Multiplicative ℤ) := Coprod.inr (Multiplicative.ofAdd (1 : ℤ))
  f ^ ((i.val + 1 : ℕ) : ℤ) * Coprod.inl b * f * Coprod.inl b *
    f ^ (-((i.val + 1 : ℕ) : ℤ)) * Coprod.inl (g i)

private abbrev MZFam (M : Type) := TwoFam M (Multiplicative ℤ)

private def collapseWord {k : ℕ} : List (Fin k × Bool) → List (Fin k × ℤ)
  | [] => []
  | (i, s) :: rest =>
    let e1 : ℤ := if s then 1 else -1
    match collapseWord rest with
    | [] => [(i, e1)]
    | (j, e2) :: tl => if i = j then (i, e1 + e2) :: tl else (i, e1) :: (j, e2) :: tl

private def rabinPBuildTail {k : ℕ} (b : M) : List (Fin k × ℤ) → List (Σ c, MZFam M c)
  | [] => []
  | [(i, r)] => [⟨false, b ^ r⟩, ⟨true, Multiplicative.ofAdd (-((i.val + 1 : ℕ) : ℤ))⟩]
  | (i, r) :: (j, r') :: tl =>
    ⟨false, b ^ r⟩ ::
    ⟨true, Multiplicative.ofAdd (((j.val + 1 : ℕ) : ℤ) - ((i.val + 1 : ℕ) : ℤ))⟩ ::
    rabinPBuildTail b ((j, r') :: tl)

/-- Helper: any `CoprodI.Word (MZFam M)` whose list contains a `true`-letter cannot equal
`coprodEquivCoprodI (Coprod.inl m)`. -/
private theorem not_inl_of_exists_true [DecidableEq M]
    (w : CoprodI.Word (MZFam M)) (ht : ∃ s ∈ w.toList, s.1 = true) (m : M) :
    w.prod ≠ coprodEquivCoprodI M (Multiplicative ℤ) (Coprod.inl m) := by
  intro heq
  rcases ht with ⟨s, hs, hs1⟩
  by_cases hm : m = 1
  · subst hm
    simp only [map_one] at heq
    have hempty : w = CoprodI.Word.empty :=
      CoprodI.Word.equiv.symm.injective (by simpa [CoprodI.Word.equiv] using heq)
    rw [hempty] at hs
    simp at hs
  · let wm : CoprodI.Word (MZFam M) :=
      ⟨[⟨false, m⟩], by simp [hm], List.isChain_singleton _⟩
    have hwm : wm.prod = coprodEquivCoprodI M (Multiplicative ℤ) (Coprod.inl m) := by
      simp [wm, CoprodI.Word.prod]
    have hweq : w = wm := CoprodI.Word.equiv.symm.injective (heq.trans hwm.symm)
    rw [hweq] at hs
    simp only [wm, List.mem_singleton] at hs
    rw [hs] at hs1
    cases hs1

/-- Both injectivity and disjointness from `Coprod.inl.range` for `rabinP`. -/
theorem rabinP_lift_not_inl {k : ℕ} {b : M} (hb : ∀ n : ℤ, b ^ n = 1 → n = 0)
    (w : FreeGroup (Fin k)) (hw : w ≠ 1) :
    FreeGroup.lift (rabinP b) w ∉ (Coprod.inl : M →* Coprod M (Multiplicative ℤ)).range := by
  classical
  let l := FreeGroup.toWord w
  have hl_red : FreeGroup.IsReduced l := FreeGroup.isReduced_toWord
  have hl_mk : FreeGroup.mk l = w := FreeGroup.mk_toWord
  have hl_ne : l ≠ [] := fun h => hw (by rw [← hl_mk, h]; rfl)
  let e := coprodEquivCoprodI M (Multiplicative ℤ)
  have hbn : ∀ n : ℤ, n ≠ 0 → b ^ n ≠ 1 := fun n hn h => hn (hb n h)
  have hnz : ∀ n : ℤ, n ≠ 0 → (Multiplicative.ofAdd n : Multiplicative ℤ) ≠ 1 := fun n hn h =>
    hn (Multiplicative.ofAdd.injective (h.trans ofAdd_zero.symm))
  have hcol : ∀ (xs : List (Fin k × Bool)), FreeGroup.IsReduced xs →
      let c := collapseWord xs
      (xs ≠ [] → c ≠ []) ∧
      (∀ p ∈ c, p.2 ≠ 0) ∧
      (c.IsChain fun p q => p.1 ≠ q.1) ∧
      (∀ i s rest, xs = (i, s) :: rest →
        ∃ exp tl, c = (i, exp) :: tl ∧ (if s then 0 < exp else exp < 0)) ∧
      ((c.map fun p => rabinP b p.1 ^ p.2).prod = FreeGroup.lift (rabinP b) (FreeGroup.mk xs)) := by
    intro xs
    induction xs with
    | nil =>
      intro _
      refine ⟨fun h => (h rfl).elim, by simp [collapseWord], List.isChain_nil, by simp,
        by simp [collapseWord]⟩
    | cons hd rest ih =>
      rcases hd with ⟨i, s⟩
      intro hred
      have hred_rest : FreeGroup.IsReduced rest := hred.tail
      obtain ⟨hne_r, hnz_r, hch_r, hhd_r, hprod_r⟩ := ih hred_rest
      cases rest with
      | nil =>
        simp only [collapseWord]
        refine ⟨by simp, by intro p hp; simp at hp; subst hp; cases s <;> simp,
          List.isChain_singleton _, ?_, ?_⟩
        · intro i' s' r' heq
          simp only [List.cons.injEq, Prod.mk.injEq] at heq
          rcases heq with ⟨⟨rfl, rfl⟩, rfl⟩
          exact ⟨if s then 1 else -1, [], rfl, by cases s <;> decide⟩
        · simp only [List.map_cons, List.map_nil, List.prod_cons, List.prod_nil, mul_one]
          cases s
          · change (rabinP b i) ^ (-1 : ℤ) = FreeGroup.lift (rabinP b) (FreeGroup.of i)⁻¹
            simp
          · change (rabinP b i) ^ (1 : ℤ) = FreeGroup.lift (rabinP b) (FreeGroup.of i)
            simp
      | cons hd2 rest' =>
        rcases hd2 with ⟨j, s2⟩
        obtain ⟨exp2, tl, hcol_r, hexp2⟩ := hhd_r j s2 rest' rfl
        have hstep_mk : FreeGroup.mk ((i, s) :: (j, s2) :: rest') =
            FreeGroup.mk [(i, s)] * FreeGroup.mk ((j, s2) :: rest') := rfl
        have hsingle : FreeGroup.lift (rabinP b) (FreeGroup.mk [(i, s)]) =
            rabinP b i ^ (if s then (1 : ℤ) else -1) := by
          cases s
          · change FreeGroup.lift (rabinP b) (FreeGroup.of i)⁻¹ = _; simp
          · change FreeGroup.lift (rabinP b) (FreeGroup.of i) = _; simp
        have hcol_step : collapseWord ((i, s) :: (j, s2) :: rest') =
            if i = j then (i, (if s then 1 else -1) + exp2) :: tl
            else (i, if s then 1 else -1) :: (j, exp2) :: tl := by
          conv_lhs => unfold collapseWord
          rw [hcol_r]
        dsimp only
        rw [hcol_step]
        by_cases hij : i = j
        · subst hij
          have hs_eq : s = s2 := (List.isChain_cons_cons.1 hred).1 rfl
          subst hs_eq
          have hsum_sign : if s then 0 < (if s then (1 : ℤ) else -1) + exp2
              else (if s then (1 : ℤ) else -1) + exp2 < 0 := by
            cases s <;> simp_all <;> omega
          have hsum_nz : (if s then (1 : ℤ) else -1) + exp2 ≠ 0 := by
            cases s <;> simp_all <;> omega
          simp only [↓reduceIte]
          refine ⟨by simp, ?_, ?_, ?_, ?_⟩
          · intro p hp
            rcases List.mem_cons.1 hp with rfl | hp
            · exact hsum_nz
            · exact hnz_r p (by rw [hcol_r]; exact List.mem_cons_of_mem _ hp)
          · rw [hcol_r] at hch_r
            exact List.isChain_cons.2 ⟨fun y hy => (List.isChain_cons.1 hch_r).1 y hy, hch_r.tail⟩
          · intro i' s' r' heq
            simp only [List.cons.injEq, Prod.mk.injEq] at heq
            rcases heq with ⟨⟨rfl, rfl⟩, rfl⟩
            exact ⟨(if s then 1 else -1) + exp2, tl, rfl, hsum_sign⟩
          · rw [hstep_mk, map_mul, hsingle, ← hprod_r, hcol_r]
            cases s <;> simp [List.map_cons, List.prod_cons, ← mul_assoc, zpow_add]
        · simp only [hij, ↓reduceIte]
          refine ⟨by simp, ?_, ?_, ?_, ?_⟩
          · intro p hp
            rcases List.mem_cons.1 hp with rfl | hp
            · cases s <;> simp
            · exact hnz_r p (by rw [hcol_r]; exact hp)
          · rw [hcol_r] at hch_r
            exact List.isChain_cons_cons.2 ⟨hij, hch_r⟩
          · intro i' s' r' heq
            simp only [List.cons.injEq, Prod.mk.injEq] at heq
            rcases heq with ⟨⟨rfl, rfl⟩, rfl⟩
            exact ⟨if s then 1 else -1, (j, exp2) :: tl, rfl, by cases s <;> decide⟩
          · rw [hstep_mk, map_mul, hsingle, ← hprod_r, hcol_r]
            simp [List.map_cons, List.prod_cons]
  obtain ⟨hc_ne, hc_nz, hc_ch, _, hc_prod⟩ := hcol l hl_red
  let c := collapseWord l
  have hc_ne' : c ≠ [] := hc_ne hl_ne
  have hrp_zpow : ∀ (i : Fin k) (r : ℤ),
      rabinP b i ^ r =
        Coprod.inr (Multiplicative.ofAdd ((i.val + 1 : ℕ) : ℤ)) * Coprod.inl (b ^ r) *
          Coprod.inr (Multiplicative.ofAdd (-((i.val + 1 : ℕ) : ℤ))) := by
    intro i r
    have h1 : rabinP b i =
        Coprod.inr (Multiplicative.ofAdd ((i.val + 1 : ℕ) : ℤ)) * Coprod.inl b *
          (Coprod.inr (Multiplicative.ofAdd ((i.val + 1 : ℕ) : ℤ)))⁻¹ := by
      simp [rabinP, ← map_zpow, ← ofAdd_zsmul, ← map_inv, ← ofAdd_neg]
    rw [h1, conj_zpow, map_zpow]
    simp [← map_inv, ← ofAdd_neg]
  have hbt : ∀ (xs : List (Fin k × ℤ)) (i0 : Fin k) (r0 : ℤ),
      xs = (i0, r0) :: xs.tail →
      (∀ p ∈ xs, p.2 ≠ 0) →
      (xs.IsChain fun p q => p.1 ≠ q.1) →
      (∀ s ∈ rabinPBuildTail b xs, s.2 ≠ 1) ∧
      (rabinPBuildTail b xs).IsChain (fun x y => x.1 ≠ y.1) ∧
      (∀ s ∈ (rabinPBuildTail b xs).head?, s.1 = false) ∧
      (e (xs.map fun p => rabinP b p.1 ^ p.2).prod =
        CoprodI.of (M := MZFam M) (i := true) (Multiplicative.ofAdd ((i0.val + 1 : ℕ) : ℤ)) *
          ((rabinPBuildTail b xs).map fun s => CoprodI.of s.2).prod) := by
    intro xs
    induction xs with
    | nil => intro _ _ h; cases h
    | cons p rest ih =>
      rcases p with ⟨i, r⟩
      intro i0 r0 heq hnz_x hch_x
      simp only [List.cons.injEq, Prod.mk.injEq] at heq
      rcases heq with ⟨⟨rfl, rfl⟩, _⟩
      have hr : r ≠ 0 := hnz_x (i, r) List.mem_cons_self
      cases rest with
      | nil =>
        refine ⟨?_, ?_, ?_, ?_⟩
        · intro s hs
          simp only [rabinPBuildTail, List.mem_cons, List.not_mem_nil, or_false] at hs
          rcases hs with rfl | rfl
          · exact hbn r hr
          · exact hnz _ (by omega)
        · exact List.isChain_cons_cons.2 ⟨by simp, List.isChain_singleton _⟩
        · simp [rabinPBuildTail]
        · simp only [List.map_cons, List.map_nil, List.prod_cons, List.prod_nil, mul_one,
            rabinPBuildTail, hrp_zpow, map_mul, e, coprodEquivCoprodI_inl, coprodEquivCoprodI_inr,
            mul_assoc]
      | cons q rest' =>
        rcases q with ⟨j, r'⟩
        have hij : i ≠ j := (List.isChain_cons_cons.1 hch_x).1
        obtain ⟨ih_ne, ih_ch, ih_hd, ih_prod⟩ := ih j r' rfl
          (fun x hx => hnz_x x (List.mem_cons_of_mem _ hx)) hch_x.tail
        have hdiff_nz : ((j.val + 1 : ℕ) : ℤ) - ((i.val + 1 : ℕ) : ℤ) ≠ 0 := by
          intro h; apply hij; exact Fin.ext (by omega)
        refine ⟨?_, ?_, ?_, ?_⟩
        · intro s hs
          simp only [rabinPBuildTail, List.mem_cons] at hs
          rcases hs with rfl | rfl | hs
          · exact hbn r hr
          · exact hnz _ hdiff_nz
          · exact ih_ne s hs
        · simp only [rabinPBuildTail]
          refine List.isChain_cons_cons.2 ⟨by simp, List.isChain_cons.2 ⟨?_, ih_ch⟩⟩
          intro y hy
          rw [ih_hd y hy]
          simp
        · simp [rabinPBuildTail]
        · rw [List.map_cons, List.prod_cons, map_mul, ih_prod]
          simp only [hrp_zpow, map_mul, e, coprodEquivCoprodI_inl, coprodEquivCoprodI_inr,
            rabinPBuildTail, List.map_cons, List.prod_cons]
          have hmerge : CoprodI.of (M := MZFam M) (i := true)
              (Multiplicative.ofAdd (-((i.val + 1 : ℕ) : ℤ))) *
              CoprodI.of (M := MZFam M) (i := true)
              (Multiplicative.ofAdd ((j.val + 1 : ℕ) : ℤ)) =
              CoprodI.of (M := MZFam M) (i := true)
              (Multiplicative.ofAdd (((j.val + 1 : ℕ) : ℤ) - ((i.val + 1 : ℕ) : ℤ))) := by
            rw [← map_mul, ← ofAdd_add, sub_eq_neg_add]
          simp only [mul_assoc]
          rw [← mul_assoc (CoprodI.of (M := MZFam M) (i := true)
            (Multiplicative.ofAdd (-((i.val + 1 : ℕ) : ℤ)))), hmerge]
  cases hc_eq : c with
  | nil => exact (hc_ne' hc_eq).elim
  | cons p0 rest0 =>
    rcases p0 with ⟨i0, r0⟩
    obtain ⟨hbt_ne, hbt_ch, hbt_hd, hbt_prod⟩ := hbt c i0 r0 (by simp [hc_eq]) hc_nz hc_ch
    let finalWord : CoprodI.Word (MZFam M) :=
      { toList := ⟨true, Multiplicative.ofAdd ((i0.val + 1 : ℕ) : ℤ)⟩ :: rabinPBuildTail b c
        ne_one := by
          intro s hs
          simp only [List.mem_cons] at hs
          rcases hs with rfl | hs
          · exact hnz _ (by omega)
          · exact hbt_ne s hs
        chain_ne := List.isChain_cons.2 ⟨fun y hy => by rw [hbt_hd y hy]; simp, hbt_ch⟩ }
    have hfw_prod : finalWord.prod = e (FreeGroup.lift (rabinP b) w) := by
      change CoprodI.of (M := MZFam M) (i := true) (Multiplicative.ofAdd ((i0.val + 1 : ℕ) : ℤ)) *
        ((rabinPBuildTail b c).map fun s => CoprodI.of s.2).prod = _
      rw [← hbt_prod, hc_prod, hl_mk]
    rintro ⟨m, hm⟩
    exact not_inl_of_exists_true finalWord ⟨_, List.mem_cons_self, rfl⟩ m
      (hfw_prod.trans (congrArg e hm.symm))

theorem rabinP_injective {k : ℕ} {b : M} (hb : ∀ n : ℤ, b ^ n = 1 → n = 0) :
    Function.Injective (FreeGroup.lift (rabinP (k := k) b)) := by
  rw [injective_iff_map_eq_one]
  intro w hw
  by_contra hne
  exact rabinP_lift_not_inl hb w hne ⟨1, by simp [hw]⟩

/-- Tail of the normal form of `(rabinQ b g i)^sign` after its protected `f^(±1)` syllable. -/
private def rabinQTail {k : ℕ} (b : M) (g : Fin k → M) [DecidableEq M]
    (i : Fin k) (s : Bool) : List (Σ c, MZFam M c) :=
  if s then
    [⟨false, b⟩, ⟨true, Multiplicative.ofAdd (-((i.val + 1 : ℕ) : ℤ))⟩] ++
      if g i = 1 then [] else [⟨false, g i⟩]
  else
    [⟨false, b⁻¹⟩, ⟨true, Multiplicative.ofAdd (-((i.val + 1 : ℕ) : ℤ))⟩]

/-- Reduced junction between the tail of `(rabinQ b g i)^s₁` and the head of `(rabinQ b g j)^s₂`
when `(i = j → s₁ = s₂)`. Always starts with `false` and ends with `false`. -/
private def rabinQJunc {k : ℕ} (b : M) (g : Fin k → M) [DecidableEq M]
    (i : Fin k) (s₁ : Bool) (j : Fin k) (s₂ : Bool) : List (Σ c, MZFam M c) :=
  let ei : ℤ := (i.val + 1 : ℕ)
  let ej : ℤ := (j.val + 1 : ℕ)
  match s₁, s₂ with
  | true, true =>
    if g i ≠ 1 then
      [⟨false, b⟩, ⟨true, Multiplicative.ofAdd (-ei)⟩, ⟨false, g i⟩,
       ⟨true, Multiplicative.ofAdd ej⟩, ⟨false, b⟩]
    else if i ≠ j then
      [⟨false, b⟩, ⟨true, Multiplicative.ofAdd (ej - ei)⟩, ⟨false, b⟩]
    else
      [⟨false, b ^ (2 : ℤ)⟩]
  | true, false =>
    if g i * (g j)⁻¹ ≠ 1 then
      [⟨false, b⟩, ⟨true, Multiplicative.ofAdd (-ei)⟩, ⟨false, g i * (g j)⁻¹⟩,
       ⟨true, Multiplicative.ofAdd ej⟩, ⟨false, b⁻¹⟩]
    else
      [⟨false, b⟩, ⟨true, Multiplicative.ofAdd (ej - ei)⟩, ⟨false, b⁻¹⟩]
  | false, true =>
    [⟨false, b⁻¹⟩, ⟨true, Multiplicative.ofAdd (ej - ei)⟩, ⟨false, b⟩]
  | false, false =>
    if g j ≠ 1 then
      [⟨false, b⁻¹⟩, ⟨true, Multiplicative.ofAdd (-ei)⟩, ⟨false, (g j)⁻¹⟩,
       ⟨true, Multiplicative.ofAdd ej⟩, ⟨false, b⁻¹⟩]
    else if i ≠ j then
      [⟨false, b⁻¹⟩, ⟨true, Multiplicative.ofAdd (ej - ei)⟩, ⟨false, b⁻¹⟩]
    else
      [⟨false, b ^ (-2 : ℤ)⟩]

/-- Both injectivity and disjointness from `Coprod.inl.range` for `rabinQ`. -/
theorem rabinQ_lift_not_inl {k : ℕ} {b : M} (hb : ∀ n : ℤ, b ^ n = 1 → n = 0)
    (g : Fin k → M) (w : FreeGroup (Fin k)) (hw : w ≠ 1) :
    FreeGroup.lift (rabinQ b g) w ∉ (Coprod.inl : M →* Coprod M (Multiplicative ℤ)).range := by
  classical
  let l := FreeGroup.toWord w
  have hl_red : FreeGroup.IsReduced l := FreeGroup.isReduced_toWord
  have hl_mk : FreeGroup.mk l = w := FreeGroup.mk_toWord
  have hl_ne : l ≠ [] := fun h => hw (by rw [← hl_mk, h]; rfl)
  let e := coprodEquivCoprodI M (Multiplicative ℤ)
  have hb1 : b ≠ 1 := fun h => (by decide : (1 : ℤ) ≠ 0) (hb 1 (by simpa using h))
  have hb2 : b ^ (2 : ℤ) ≠ 1 := fun h => (by decide : (2 : ℤ) ≠ 0) (hb 2 h)
  have hbm2 : b ^ (-2 : ℤ) ≠ 1 := fun h => (by decide : (-2 : ℤ) ≠ 0) (hb (-2) h)
  have hnz : ∀ n : ℤ, n ≠ 0 → (Multiplicative.ofAdd n : Multiplicative ℤ) ≠ 1 := fun n hn h =>
    hn (Multiplicative.ofAdd.injective (h.trans ofAdd_zero.symm))
  let listProd (xs : List (Σ c, MZFam M c)) : CoprodI (MZFam M) :=
    (xs.map fun s => CoprodI.of s.2).prod
  have listProd_append : ∀ xs ys, listProd (xs ++ ys) = listProd xs * listProd ys := by
    intro xs ys; simp [listProd]
  have htail_props : ∀ i s,
      (∀ x ∈ rabinQTail b g i s, x.2 ≠ 1) ∧
      (rabinQTail b g i s).IsChain (fun x y => x.1 ≠ y.1) ∧
      (∀ x ∈ (rabinQTail b g i s).head?, x.1 = false) := by
    intro i s
    cases s
    · refine ⟨?_, ?_, ?_⟩
      · intro x hx
        simp only [rabinQTail, Bool.false_eq_true, ↓reduceIte, List.mem_cons,
          List.not_mem_nil, or_false] at hx
        rcases hx with rfl | rfl
        · exact inv_ne_one.mpr hb1
        · exact hnz _ (by omega)
      · exact List.isChain_cons_cons.2 ⟨by simp, List.isChain_singleton _⟩
      · simp [rabinQTail]
    · by_cases hgi : g i = 1
      · refine ⟨?_, ?_, ?_⟩
        · intro x hx
          simp only [rabinQTail, ↓reduceIte, hgi, List.append_nil, List.mem_cons,
            List.not_mem_nil, or_false] at hx
          rcases hx with rfl | rfl
          · exact hb1
          · exact hnz _ (by omega)
        · simp only [rabinQTail, ↓reduceIte, hgi, List.append_nil]
          exact List.isChain_cons_cons.2 ⟨by simp, List.isChain_singleton _⟩
        · simp [rabinQTail, hgi]
      · refine ⟨?_, ?_, ?_⟩
        · intro x hx
          simp only [rabinQTail, ↓reduceIte, hgi, List.cons_append, List.nil_append,
            List.mem_cons, List.not_mem_nil, or_false] at hx
          rcases hx with rfl | rfl | rfl
          · exact hb1
          · exact hnz _ (by omega)
          · exact hgi
        · simp only [rabinQTail, ↓reduceIte, hgi, List.cons_append, List.nil_append]
          exact List.isChain_cons_cons.2 ⟨by simp, List.isChain_cons_cons.2
            ⟨by simp, List.isChain_singleton _⟩⟩
        · simp [rabinQTail, hgi]
  have hjunc_props : ∀ i s₁ j s₂, (i = j → s₁ = s₂) →
      (∀ x ∈ rabinQJunc b g i s₁ j s₂, x.2 ≠ 1) ∧
      (rabinQJunc b g i s₁ j s₂).IsChain (fun x y => x.1 ≠ y.1) ∧
      (∀ x ∈ (rabinQJunc b g i s₁ j s₂).head?, x.1 = false) ∧
      (∀ x ∈ (rabinQJunc b g i s₁ j s₂).getLast?, x.1 = false) ∧
      (listProd (rabinQJunc b g i s₁ j s₂) =
        listProd (rabinQTail b g i s₁) *
          (if s₂ then
            e (Coprod.inr (Multiplicative.ofAdd ((j.val + 1 : ℕ) : ℤ)) * Coprod.inl b)
          else
            e (Coprod.inl (g j)⁻¹ * Coprod.inr (Multiplicative.ofAdd ((j.val + 1 : ℕ) : ℤ)) *
              Coprod.inl b⁻¹))) := by
    intro i s₁ j s₂ hnotinv
    have hdiff_nz : i ≠ j → ((j.val + 1 : ℕ) : ℤ) - ((i.val + 1 : ℕ) : ℤ) ≠ 0 := by
      intro hij h; apply hij; exact Fin.ext (by omega)
    have hadd_f : ∀ a c : ℤ,
        CoprodI.of (M := MZFam M) (i := true) (Multiplicative.ofAdd a) *
          CoprodI.of (M := MZFam M) (i := true) (Multiplicative.ofAdd c) =
        CoprodI.of (M := MZFam M) (i := true) (Multiplicative.ofAdd (a + c)) := by
      intro a c; rw [← map_mul, ← ofAdd_add]
    have hmul_m : ∀ x y : M,
        CoprodI.of (M := MZFam M) (i := false) x *
          CoprodI.of (M := MZFam M) (i := false) y =
        CoprodI.of (M := MZFam M) (i := false) (x * y) := by
      intro x y; rw [← map_mul]
    cases s₁ <;> cases s₂
    · simp only [rabinQJunc, rabinQTail, Bool.false_eq_true, ↓reduceIte]
      by_cases hgj : g j = 1
      · by_cases hij : i = j
        · subst hij
          simp only [hgj, ne_eq, not_true_eq_false, ↓reduceIte]
          refine ⟨fun x hx => by simp only [List.mem_singleton] at hx; subst hx; exact hbm2,
            List.isChain_singleton _, by simp, by simp, ?_⟩
          simp only [listProd, List.map_cons, List.map_nil, List.prod_cons, List.prod_nil,
            mul_one, inv_one, map_one, one_mul, map_mul, e, coprodEquivCoprodI_inl,
            coprodEquivCoprodI_inr, mul_assoc]
          rw [← mul_assoc (CoprodI.of (M := MZFam M) (i := true) _), hadd_f, neg_add_cancel,
            ofAdd_zero, map_one, one_mul, hmul_m]
          congr 1; rw [zpow_neg, zpow_two, mul_inv_rev]
        · simp only [hgj, ne_eq, not_true_eq_false, ↓reduceIte, hij, not_false_eq_true]
          refine ⟨?_, List.isChain_cons_cons.2 ⟨by simp, List.isChain_cons_cons.2
            ⟨by simp, List.isChain_singleton _⟩⟩, by simp, by simp, ?_⟩
          · intro x hx
            simp only [List.mem_cons, List.not_mem_nil, or_false] at hx
            rcases hx with rfl | rfl | rfl
            · exact inv_ne_one.mpr hb1
            · exact hnz _ (hdiff_nz hij)
            · exact inv_ne_one.mpr hb1
          · simp only [listProd, List.map_cons, List.map_nil, List.prod_cons, List.prod_nil,
              mul_one, inv_one, map_one, one_mul, map_mul, e, coprodEquivCoprodI_inl,
              coprodEquivCoprodI_inr, mul_assoc]
            rw [← mul_assoc (CoprodI.of (M := MZFam M) (i := true) _), hadd_f, sub_eq_neg_add]
      · simp only [ne_eq, hgj, not_false_eq_true, ↓reduceIte]
        refine ⟨?_, List.isChain_cons_cons.2 ⟨by simp, List.isChain_cons_cons.2 ⟨by simp,
          List.isChain_cons_cons.2 ⟨by simp, List.isChain_cons_cons.2
            ⟨by simp, List.isChain_singleton _⟩⟩⟩⟩, by simp, by simp, ?_⟩
        · intro x hx
          simp only [List.mem_cons, List.not_mem_nil, or_false] at hx
          rcases hx with rfl | rfl | rfl | rfl | rfl
          · exact inv_ne_one.mpr hb1
          · exact hnz _ (by omega)
          · exact inv_ne_one.mpr hgj
          · exact hnz _ (by omega)
          · exact inv_ne_one.mpr hb1
        · simp [listProd, e, mul_assoc]
    · have hij : i ≠ j := fun h => Bool.false_ne_true (hnotinv h)
      simp only [rabinQJunc, rabinQTail, Bool.false_eq_true, ↓reduceIte]
      refine ⟨?_, List.isChain_cons_cons.2 ⟨by simp, List.isChain_cons_cons.2
        ⟨by simp, List.isChain_singleton _⟩⟩, by simp, by simp, ?_⟩
      · intro x hx
        simp only [List.mem_cons, List.not_mem_nil, or_false] at hx
        rcases hx with rfl | rfl | rfl
        · exact inv_ne_one.mpr hb1
        · exact hnz _ (hdiff_nz hij)
        · exact hb1
      · simp only [listProd, List.map_cons, List.map_nil, List.prod_cons, List.prod_nil,
          mul_one, map_mul, e, coprodEquivCoprodI_inl, coprodEquivCoprodI_inr, mul_assoc]
        rw [← mul_assoc (CoprodI.of (M := MZFam M) (i := true) _), hadd_f, sub_eq_neg_add]
    · have hij : i ≠ j := fun h => Bool.noConfusion (hnotinv h)
      simp only [rabinQJunc, rabinQTail, ↓reduceIte, Bool.false_eq_true]
      by_cases hgg : g i * (g j)⁻¹ = 1
      · simp only [ne_eq, hgg, not_true_eq_false, ↓reduceIte]
        refine ⟨?_, List.isChain_cons_cons.2 ⟨by simp, List.isChain_cons_cons.2
          ⟨by simp, List.isChain_singleton _⟩⟩, by simp, by simp, ?_⟩
        · intro x hx
          simp only [List.mem_cons, List.not_mem_nil, or_false] at hx
          rcases hx with rfl | rfl | rfl
          · exact hb1
          · exact hnz _ (hdiff_nz hij)
          · exact inv_ne_one.mpr hb1
        · by_cases hgi : g i = 1
          · have hgj : (g j)⁻¹ = 1 := by simpa [hgi] using hgg
            simp only [hgi, ↓reduceIte, List.append_nil, listProd, List.map_cons, List.map_nil,
              List.prod_cons, List.prod_nil, mul_one, hgj, map_one, one_mul, map_mul, e,
              coprodEquivCoprodI_inl, coprodEquivCoprodI_inr, mul_assoc]
            rw [← mul_assoc (CoprodI.of (M := MZFam M) (i := true) _), hadd_f, sub_eq_neg_add]
          · simp only [hgi, ↓reduceIte, List.cons_append, List.nil_append, listProd, List.map_cons,
              List.map_nil, List.prod_cons, List.prod_nil, mul_one, map_mul, e,
              coprodEquivCoprodI_inl, coprodEquivCoprodI_inr, mul_assoc]
            rw [← mul_assoc (CoprodI.of (M := MZFam M) (i := false) (g i)), hmul_m, hgg, map_one,
              one_mul, ← mul_assoc (CoprodI.of (M := MZFam M) (i := true) _), hadd_f, sub_eq_neg_add]
      · simp only [ne_eq, hgg, not_false_eq_true, ↓reduceIte]
        refine ⟨?_, List.isChain_cons_cons.2 ⟨by simp, List.isChain_cons_cons.2 ⟨by simp,
          List.isChain_cons_cons.2 ⟨by simp, List.isChain_cons_cons.2
            ⟨by simp, List.isChain_singleton _⟩⟩⟩⟩, by simp, by simp, ?_⟩
        · intro x hx
          simp only [List.mem_cons, List.not_mem_nil, or_false] at hx
          rcases hx with rfl | rfl | rfl | rfl | rfl
          · exact hb1
          · exact hnz _ (by omega)
          · exact hgg
          · exact hnz _ (by omega)
          · exact inv_ne_one.mpr hb1
        · by_cases hgi : g i = 1
          · simp only [hgi, ↓reduceIte, List.append_nil, one_mul, listProd, List.map_cons,
              List.map_nil, List.prod_cons, List.prod_nil, mul_one, map_mul, e,
              coprodEquivCoprodI_inl, coprodEquivCoprodI_inr, mul_assoc]
          · simp only [hgi, ↓reduceIte, List.cons_append, List.nil_append, listProd, List.map_cons,
              List.map_nil, List.prod_cons, List.prod_nil, mul_one, map_mul, e,
              coprodEquivCoprodI_inl, coprodEquivCoprodI_inr, mul_assoc]
    · simp only [rabinQJunc, rabinQTail, ↓reduceIte]
      by_cases hgi : g i = 1
      · by_cases hij : i = j
        · subst hij
          simp only [hgi, ne_eq, not_true_eq_false, ↓reduceIte, List.append_nil]
          refine ⟨fun x hx => by simp only [List.mem_singleton] at hx; subst hx; exact hb2,
            List.isChain_singleton _, by simp, by simp, ?_⟩
          simp only [listProd, List.map_cons, List.map_nil, List.prod_cons, List.prod_nil,
            mul_one, map_mul, e, coprodEquivCoprodI_inl, coprodEquivCoprodI_inr, mul_assoc]
          rw [← mul_assoc (CoprodI.of (M := MZFam M) (i := true) _), hadd_f, neg_add_cancel,
            ofAdd_zero, map_one, one_mul, hmul_m]
          congr 1; rw [zpow_two]
        · simp only [hgi, ne_eq, not_true_eq_false, ↓reduceIte, hij, not_false_eq_true, List.append_nil]
          refine ⟨?_, List.isChain_cons_cons.2 ⟨by simp, List.isChain_cons_cons.2
            ⟨by simp, List.isChain_singleton _⟩⟩, by simp, by simp, ?_⟩
          · intro x hx
            simp only [List.mem_cons, List.not_mem_nil, or_false] at hx
            rcases hx with rfl | rfl | rfl
            · exact hb1
            · exact hnz _ (hdiff_nz hij)
            · exact hb1
          · simp only [listProd, List.map_cons, List.map_nil, List.prod_cons, List.prod_nil,
              mul_one, map_mul, e, coprodEquivCoprodI_inl, coprodEquivCoprodI_inr, mul_assoc]
            rw [← mul_assoc (CoprodI.of (M := MZFam M) (i := true) _), hadd_f, sub_eq_neg_add]
      · simp only [ne_eq, hgi, not_false_eq_true, ↓reduceIte, List.cons_append, List.nil_append]
        refine ⟨?_, List.isChain_cons_cons.2 ⟨by simp, List.isChain_cons_cons.2 ⟨by simp,
          List.isChain_cons_cons.2 ⟨by simp, List.isChain_cons_cons.2
            ⟨by simp, List.isChain_singleton _⟩⟩⟩⟩, by simp, by simp, ?_⟩
        · intro x hx
          simp only [List.mem_cons, List.not_mem_nil, or_false] at hx
          rcases hx with rfl | rfl | rfl | rfl | rfl
          · exact hb1
          · exact hnz _ (by omega)
          · exact hgi
          · exact hnz _ (by omega)
          · exact hb1
        · simp [listProd, e, mul_assoc]
  have hmain : ∀ (xs : List (Fin k × Bool)), xs ≠ [] → FreeGroup.IsReduced xs →
      ∃ (pre : List (Σ c, MZFam M c)) (i : Fin k) (s : Bool),
        xs.getLast? = some (i, s) ∧
        (let full := pre ++ [⟨true, Multiplicative.ofAdd (if s then (1 : ℤ) else -1)⟩] ++
            rabinQTail b g i s
         (∀ x ∈ full, x.2 ≠ 1) ∧
         full.IsChain (fun x y => x.1 ≠ y.1) ∧
         listProd full = e (FreeGroup.lift (rabinQ b g) (FreeGroup.mk xs))) := by
    intro xs
    induction xs using List.reverseRecOn with
    | nil => intro h; exact (h rfl).elim
    | append_singleton xs p ih =>
      rcases p with ⟨j, s2⟩
      intro _ hred
      cases xs with
      | nil =>
        let pre : List (Σ c, MZFam M c) :=
          if s2 then
            [⟨true, Multiplicative.ofAdd ((j.val + 1 : ℕ) : ℤ)⟩, ⟨false, b⟩]
          else
            (if g j = 1 then [] else [⟨false, (g j)⁻¹⟩]) ++
              [⟨true, Multiplicative.ofAdd ((j.val + 1 : ℕ) : ℤ)⟩, ⟨false, b⁻¹⟩]
        refine ⟨pre, j, s2, by simp, ?_, ?_, ?_⟩
        · intro x hx
          cases s2
          · simp only [pre, Bool.false_eq_true, ↓reduceIte, rabinQTail, List.mem_append,
              List.mem_cons, List.not_mem_nil, or_false] at hx
            rcases hx with (((hx | rfl | rfl) | rfl) | (rfl | rfl))
            · by_cases hgj : g j = 1
              · simp [hgj] at hx
              · simp only [hgj, ↓reduceIte, List.mem_singleton] at hx
                subst hx; exact inv_ne_one.mpr hgj
            · exact hnz _ (by omega)
            · exact inv_ne_one.mpr hb1
            · exact hnz _ (by decide)
            · exact inv_ne_one.mpr hb1
            · exact hnz _ (by omega)
          · simp only [pre, ↓reduceIte, List.mem_append, List.mem_cons, List.not_mem_nil,
              or_false] at hx
            rcases hx with ((rfl | rfl) | rfl) | hx
            · exact hnz _ (by omega)
            · exact hb1
            · exact hnz _ (by decide)
            · exact (htail_props j true).1 x hx
        · cases s2
          · by_cases hgj : g j = 1
            · simp only [pre, hgj, Bool.false_eq_true, ↓reduceIte, rabinQTail,
                List.nil_append, List.cons_append]
              exact List.isChain_cons_cons.2 ⟨by simp, List.isChain_cons_cons.2 ⟨by simp,
                List.isChain_cons_cons.2 ⟨by simp, List.isChain_cons_cons.2
                  ⟨by simp, List.isChain_singleton _⟩⟩⟩⟩
            · simp only [pre, hgj, Bool.false_eq_true, ↓reduceIte, rabinQTail,
                List.cons_append, List.nil_append]
              exact List.isChain_cons_cons.2 ⟨by simp, List.isChain_cons_cons.2 ⟨by simp,
                List.isChain_cons_cons.2 ⟨by simp, List.isChain_cons_cons.2 ⟨by simp,
                  List.isChain_cons_cons.2 ⟨by simp, List.isChain_singleton _⟩⟩⟩⟩⟩
          · obtain ⟨_, htc, hthd⟩ := htail_props j true
            simp only [pre, ↓reduceIte, List.cons_append, List.nil_append]
            refine List.isChain_cons_cons.2 ⟨by simp, List.isChain_cons_cons.2 ⟨by simp,
              List.isChain_cons.2 ⟨?_, htc⟩⟩⟩
            intro y hy; rw [hthd y hy]; simp
        · cases s2
          · have hrq_inv : (rabinQ b g j)⁻¹ =
                Coprod.inl (g j)⁻¹ * Coprod.inr (Multiplicative.ofAdd ((j.val + 1 : ℕ) : ℤ)) *
                  Coprod.inl b⁻¹ * Coprod.inr (Multiplicative.ofAdd (-1 : ℤ)) *
                  Coprod.inl b⁻¹ * Coprod.inr (Multiplicative.ofAdd (-((j.val + 1 : ℕ) : ℤ))) := by
              simp only [rabinQ, ← map_zpow, ← ofAdd_zsmul, mul_inv_rev, ← map_inv, ← ofAdd_neg,
                zsmul_eq_mul, Int.cast_id, mul_one, neg_neg, mul_assoc]
            change listProd (pre ++ _ ++ rabinQTail b g j false) =
              e (FreeGroup.lift (rabinQ b g) (FreeGroup.of j)⁻¹)
            rw [map_inv (FreeGroup.lift (rabinQ b g)), FreeGroup.lift_apply_of, hrq_inv]
            by_cases hgj : g j = 1 <;> simp [pre, hgj, rabinQTail, listProd, e, mul_assoc]
          · have hrq : rabinQ b g j =
                Coprod.inr (Multiplicative.ofAdd ((j.val + 1 : ℕ) : ℤ)) * Coprod.inl b *
                  Coprod.inr (Multiplicative.ofAdd (1 : ℤ)) * Coprod.inl b *
                  Coprod.inr (Multiplicative.ofAdd (-((j.val + 1 : ℕ) : ℤ))) * Coprod.inl (g j) := by
              simp only [rabinQ, ← map_zpow, ← ofAdd_zsmul, zsmul_eq_mul, Int.cast_id, mul_one]
            change listProd (pre ++ _ ++ rabinQTail b g j true) =
              e (FreeGroup.lift (rabinQ b g) (FreeGroup.of j))
            rw [FreeGroup.lift_apply_of, hrq]
            by_cases hgj : g j = 1 <;> simp [pre, hgj, rabinQTail, listProd, e, mul_assoc]
      | cons x xs' =>
        have hxs_ne : x :: xs' ≠ [] := List.cons_ne_nil _ _
        have hxs_red : FreeGroup.IsReduced (x :: xs') := (List.isChain_append.1 hred).1
        obtain ⟨pre, i, s1, hlast, hne_full, hch_full, hprod_full⟩ := ih hxs_ne hxs_red
        have hnotinv : i = j → s1 = s2 := by
          have hrel := List.isChain_append.1 hred
          exact hrel.2.2 (i, s1) hlast (j, s2) rfl
        obtain ⟨hj_ne, hj_ch, hj_hd, hj_last, hj_prod⟩ := hjunc_props i s1 j s2 hnotinv
        obtain ⟨ht_ne, ht_ch, ht_hd⟩ := htail_props j s2
        let mid1 : Σ c, MZFam M c := ⟨true, Multiplicative.ofAdd (if s1 then (1 : ℤ) else -1)⟩
        let mid2 : Σ c, MZFam M c := ⟨true, Multiplicative.ofAdd (if s2 then (1 : ℤ) else -1)⟩
        let newPre := pre ++ [mid1] ++ rabinQJunc b g i s1 j s2
        refine ⟨newPre, j, s2, ?_, ?_, ?_, ?_⟩
        · rw [List.getLast?_append_of_ne_nil _ (List.cons_ne_nil _ _)]; rfl
        · intro y hy
          simp only [newPre, List.mem_append, List.mem_singleton] at hy
          rcases hy with (((hy | rfl) | hy) | rfl) | hy
          · exact hne_full y (by simp [hy])
          · exact hnz _ (by cases s1 <;> decide)
          · exact hj_ne y hy
          · exact hnz _ (by cases s2 <;> decide)
          · exact ht_ne y hy
        · have hpre_ch : (pre ++ [mid1]).IsChain (fun a b => a.1 ≠ b.1) :=
            (List.isChain_append.1 hch_full).1
          have h1 : (pre ++ [mid1] ++ rabinQJunc b g i s1 j s2).IsChain (fun a b => a.1 ≠ b.1) :=
            List.isChain_append.2 ⟨hpre_ch, hj_ch, fun a ha c hc => by
              simp only [List.getLast?_append_of_ne_nil _ (List.cons_ne_nil _ _),
                List.getLast?_singleton, Option.mem_def, Option.some.injEq] at ha
              subst ha
              rw [hj_hd c hc]; simp⟩
          have h2 : (newPre ++ [mid2]).IsChain (fun a b => a.1 ≠ b.1) :=
            List.isChain_append.2 ⟨h1, List.isChain_singleton _, fun a ha c hc => by
              simp only [List.head?_singleton, Option.mem_def, Option.some.injEq] at hc
              subst hc
              have hj_ne_nil : rabinQJunc b g i s1 j s2 ≠ [] := by
                cases s1 <;> cases s2 <;> simp [rabinQJunc] <;> split_ifs <;> simp
              simp only [newPre, List.getLast?_append_of_ne_nil _ hj_ne_nil] at ha
              rw [hj_last a ha]; simp⟩
          exact List.isChain_append.2 ⟨h2, ht_ch, fun a ha c hc => by
            simp only [List.getLast?_append_of_ne_nil _ (List.cons_ne_nil _ _),
              List.getLast?_singleton, Option.mem_def, Option.some.injEq] at ha
            subst ha
            rw [ht_hd c hc]; simp⟩
        · have hstep : FreeGroup.mk ((x :: xs') ++ [(j, s2)]) =
              FreeGroup.mk (x :: xs') * FreeGroup.mk [(j, s2)] := FreeGroup.mul_mk.symm
          rw [hstep, map_mul, map_mul, ← hprod_full]
          simp only [newPre, listProd_append, mul_assoc]
          rw [hj_prod, mul_assoc, mul_assoc]
          congr 2
          cases s2
          · have hrq_inv : (rabinQ b g j)⁻¹ =
                (Coprod.inl (g j)⁻¹ * Coprod.inr (Multiplicative.ofAdd ((j.val + 1 : ℕ) : ℤ)) *
                  Coprod.inl b⁻¹) * Coprod.inr (Multiplicative.ofAdd (-1 : ℤ)) *
                  (Coprod.inl b⁻¹ * Coprod.inr (Multiplicative.ofAdd (-((j.val + 1 : ℕ) : ℤ)))) := by
              simp only [rabinQ, ← map_zpow, ← ofAdd_zsmul, mul_inv_rev, ← map_inv, ← ofAdd_neg,
                zsmul_eq_mul, Int.cast_id, mul_one, neg_neg, mul_assoc]
            change _ = listProd (rabinQTail b g i s1) *
              e (FreeGroup.lift (rabinQ b g) (FreeGroup.of j)⁻¹)
            rw [map_inv (FreeGroup.lift (rabinQ b g)), FreeGroup.lift_apply_of, hrq_inv]
            simp [rabinQTail, listProd, e, mul_assoc]
          · have hrq : rabinQ b g j =
                (Coprod.inr (Multiplicative.ofAdd ((j.val + 1 : ℕ) : ℤ)) * Coprod.inl b) *
                  Coprod.inr (Multiplicative.ofAdd (1 : ℤ)) *
                  (Coprod.inl b * Coprod.inr (Multiplicative.ofAdd (-((j.val + 1 : ℕ) : ℤ))) *
                    Coprod.inl (g j)) := by
              simp only [rabinQ, ← map_zpow, ← ofAdd_zsmul, zsmul_eq_mul, Int.cast_id, mul_one,
                mul_assoc]
            change _ = listProd (rabinQTail b g i s1) *
              e (FreeGroup.lift (rabinQ b g) (FreeGroup.of j))
            rw [FreeGroup.lift_apply_of, hrq]
            by_cases hgj : g j = 1 <;> simp [rabinQTail, hgj, listProd, e, mul_assoc]
  obtain ⟨pre, i, s, _, hne_f, hch_f, hprod_f⟩ := hmain l hl_ne hl_red
  let mid : Σ c, MZFam M c := ⟨true, Multiplicative.ofAdd (if s then (1 : ℤ) else -1)⟩
  let finalWord : CoprodI.Word (MZFam M) :=
    ⟨pre ++ [mid] ++ rabinQTail b g i s, hne_f, hch_f⟩
  have hfw_prod : finalWord.prod = e (FreeGroup.lift (rabinQ b g) w) := by
    rw [← hl_mk]
    exact hprod_f
  rintro ⟨m, hm⟩
  exact not_inl_of_exists_true finalWord ⟨mid, by simp [finalWord], rfl⟩ m
    (hfw_prod.trans (congrArg e hm.symm))

theorem rabinQ_injective {k : ℕ} {b : M} (hb : ∀ n : ℤ, b ^ n = 1 → n = 0) (g : Fin k → M) :
    Function.Injective (FreeGroup.lift (rabinQ b g)) := by
  rw [injective_iff_map_eq_one]
  intro w hw
  by_contra hne
  exact rabinQ_lift_not_inl hb g w hne ⟨1, by simp [hw]⟩

end RabinFreeSubgroups

/-! ### Part 7: Free Subgroup of Rank 2 in an HNN Extension via Britton's Lemma -/

section HNNFreePair

private def splitHNNPair : List (Fin 2 × Bool) → ℤ × List (ℤˣ × ℤ)
  | [] => (0, [])
  | (i, s) :: rest =>
    let (hd, tl) := splitHNNPair rest
    if i = 0 then
      (hd + (if s then 1 else -1), tl)
    else
      (0, (if s then 1 else -1, hd) :: tl)

/-- In `HNNExtension G A B φ`, if `b : G` has infinite order and `⟨b⟩ ∩ A = ⊥` and `⟨b⟩ ∩ B = ⊥`,
then `of b` and `t` freely generate a free group of rank 2. -/
theorem hnn_free_pair_injective {G : Type*} [Group G] {A B : Subgroup G} (φ : A ≃* B)
    (b : G) (hb : ∀ n : ℤ, b ^ n = 1 → n = 0)
    (hA : ∀ n : ℤ, n ≠ 0 → b ^ n ∉ A) (hB : ∀ n : ℤ, n ≠ 0 → b ^ n ∉ B) :
    Function.Injective (FreeGroup.lift fun i : Fin 2 =>
      if i = 0 then (HNNExtension.of b : HNNExtension G A B φ) else HNNExtension.t) := by
  let pairFn : Fin 2 → HNNExtension G A B φ :=
    fun i => if i = 0 then HNNExtension.of b else HNNExtension.t
  rw [injective_iff_map_eq_one]
  intro w hw
  let l := FreeGroup.toWord w
  have hl_red : FreeGroup.IsReduced l := FreeGroup.isReduced_toWord
  have hl_mk : FreeGroup.mk l = w := FreeGroup.mk_toWord
  have hsplit : ∀ (xs : List (Fin 2 × Bool)), FreeGroup.IsReduced xs →
      let (hd, tl) := splitHNNPair xs
      (∀ s rest, xs = (0, s) :: rest → (if s then 0 < hd else hd < 0)) ∧
      (∀ s rest, xs = (1, s) :: rest → hd = 0 ∧ ∃ e tl', tl = (if s then 1 else -1, e) :: tl') ∧
      (tl.IsChain fun a b => a.2 = 0 → a.1 = b.1) ∧
      (HNNExtension.of (b ^ hd) *
          (tl.map fun x => HNNExtension.t ^ (x.1 : ℤ) * HNNExtension.of (b ^ x.2)).prod =
        FreeGroup.lift pairFn (FreeGroup.mk xs)) := by
    intro xs
    induction xs with
    | nil =>
      intro _
      exact ⟨by simp, by simp, List.isChain_nil, by simp⟩
    | cons p rest ih =>
      rcases p with ⟨i, s⟩
      intro hred
      obtain ⟨ih0, ih1, ihch, ihprod⟩ := ih hred.tail
      rcases hsp : splitHNNPair rest with ⟨hd, tl⟩
      rw [hsp] at ih0 ih1 ihch ihprod
      dsimp only at ih0 ih1 ihch ihprod
      have hmk : FreeGroup.mk ((i, s) :: rest) = FreeGroup.mk [(i, s)] * FreeGroup.mk rest := rfl
      have hi01 : i = 0 ∨ i = 1 := by omega
      rcases hi01 with rfl | rfl
      · simp only [splitHNNPair, hsp, ↓reduceIte]
        have hhd_sign : if s then 0 < hd + (if s then 1 else -1) else hd + (if s then 1 else -1) < 0 := by
          cases rest with
          | nil =>
            simp only [splitHNNPair, Prod.mk.injEq] at hsp
            rcases hsp with ⟨rfl, rfl⟩
            cases s <;> decide
          | cons q rest' =>
            rcases q with ⟨j, s2⟩
            have hj01 : j = 0 ∨ j = 1 := by omega
            rcases hj01 with rfl | rfl
            · have hs_eq : s = s2 := (List.isChain_cons_cons.1 hred).1 rfl
              subst hs_eq
              have h := ih0 s rest' rfl
              cases s <;> (simp only [Bool.false_eq_true, ↓reduceIte] at h ⊢; omega)
            · obtain ⟨rfl, _⟩ := ih1 s2 rest' rfl
              cases s <;> decide
        refine ⟨?_, by simp, ihch, ?_⟩
        · intro s' r' heq
          simp only [List.cons.injEq, Prod.mk.injEq, true_and] at heq
          rcases heq with ⟨rfl, rfl⟩
          exact hhd_sign
        · rw [hmk, map_mul, ← ihprod]
          have h0 : FreeGroup.lift pairFn (FreeGroup.mk [(0, s)]) =
              HNNExtension.of (b ^ (if s then (1 : ℤ) else -1)) := by
            cases s
            · change FreeGroup.lift pairFn (FreeGroup.of 0)⁻¹ = _; simp [pairFn]
            · change FreeGroup.lift pairFn (FreeGroup.of 0) = _; simp [pairFn]
          rw [h0, ← mul_assoc, ← map_mul, ← zpow_add, add_comm]
      · simp only [splitHNNPair, hsp, show (1 : Fin 2) ≠ 0 by decide, ↓reduceIte]
        refine ⟨by simp, ?_, ?_, ?_⟩
        · intro s' r' heq
          simp only [List.cons.injEq, Prod.mk.injEq, true_and] at heq
          rcases heq with ⟨rfl, rfl⟩
          exact ⟨trivial, hd, tl, rfl⟩
        · refine List.isChain_cons.2 ⟨?_, ihch⟩
          intro nxt hnxt hhd0
          cases rest with
          | nil =>
            simp only [splitHNNPair, Prod.mk.injEq] at hsp
            rcases hsp with ⟨_, rfl⟩
            simp at hnxt
          | cons q rest' =>
            rcases q with ⟨j, s2⟩
            have hj01 : j = 0 ∨ j = 1 := by omega
            rcases hj01 with rfl | rfl
            · have h := ih0 s2 rest' rfl
              cases s2 <;> simp_all
            · obtain ⟨_, e', tl', htl⟩ := ih1 s2 rest' rfl
              rw [htl] at hnxt
              simp only [List.head?_cons, Option.mem_def, Option.some.injEq] at hnxt
              subst hnxt
              have hs_eq : s = s2 := (List.isChain_cons_cons.1 hred).1 rfl
              subst hs_eq
              rfl
        · rw [hmk, map_mul, ← ihprod]
          have h1 : FreeGroup.lift pairFn (FreeGroup.mk [(1, s)]) =
              HNNExtension.t ^ ((if s then (1 : ℤˣ) else -1 : ℤˣ) : ℤ) := by
            cases s
            · change FreeGroup.lift pairFn (FreeGroup.of 1)⁻¹ = _; simp [pairFn]
            · change FreeGroup.lift pairFn (FreeGroup.of 1) = _; simp [pairFn]
          simp [h1, mul_assoc]
  obtain ⟨h0, h1, hch, hprod⟩ := hsplit l hl_red
  rcases hsp : splitHNNPair l with ⟨hd, tl⟩
  rw [hsp] at h0 h1 hch hprod
  dsimp only at h0 h1 hch hprod
  let rw_word : HNNExtension.NormalWord.ReducedWord G A B :=
    { head := b ^ hd
      toList := tl.map fun x => (x.1, b ^ x.2)
      chain := by
        rw [List.isChain_map]
        refine hch.imp ?_
        intro x y hxy hmem
        apply hxy
        by_contra hne
        rcases Int.units_eq_one_or x.1 with hx | hx
        · rw [hx] at hmem; exact hA x.2 hne hmem
        · rw [hx] at hmem; exact hB x.2 hne hmem }
  have hrw_prod : rw_word.prod φ = 1 := by
    change HNNExtension.of (b ^ hd) *
      ((tl.map fun x => (x.1, b ^ x.2)).map fun x =>
        HNNExtension.t ^ (x.1 : ℤ) * HNNExtension.of x.2).prod = 1
    rw [List.map_map]
    change HNNExtension.of (b ^ hd) *
      (tl.map fun x => HNNExtension.t ^ (x.1 : ℤ) * HNNExtension.of (b ^ x.2)).prod = 1
    rw [hprod, hl_mk, hw]
  have hnil := HNNExtension.ReducedWord.toList_eq_nil_of_mem_of_range φ rw_word ⟨1, by simp [hrw_prod]⟩
  have htl_nil : tl = [] := by
    simpa [rw_word] using hnil
  rw [htl_nil] at hprod
  simp only [List.map_nil, List.prod_nil, mul_one] at hprod
  rw [hl_mk, hw] at hprod
  have hhd_zero : hd = 0 := hb hd (HNNExtension.of_injective φ (hprod.trans (map_one _).symm))
  cases hl_eq : l with
  | nil => rw [hl_eq] at hl_mk; exact hl_mk.symm
  | cons p rest =>
    rcases p with ⟨i, s⟩
    have hi01 : i = 0 ∨ i = 1 := by omega
    rcases hi01 with rfl | rfl
    · have hsign := h0 s rest hl_eq
      rw [hhd_zero] at hsign
      cases s <;> simp at hsign
    · obtain ⟨_, e', tl', htl_cons⟩ := h1 s rest hl_eq
      rw [htl_nil] at htl_cons
      cases htl_cons

end HNNFreePair

end Adian
